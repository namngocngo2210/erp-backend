          type: string
          format: date
      required:
      - count
      - from_user_id
      - sheet
      - to_user_id
    _Upsert:
      type: object
      properties:
        date:
          type: string
          format: date
        shift:
          $ref: '#/components/schemas/ShiftEnum'
        rows:
          type: array
          items:
            $ref: '#/components/schemas/_Row'
      required:
