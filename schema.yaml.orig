  /api/sale/contacts:
    get:
      operationId: sale_contacts_list
      parameters:
      - in: query
        name: action_needed
        schema:
          type: array
          items:
            type: string
        description: Lọc theo action_needed (nhiều giá trị)
      - in: query
        name: channel
        schema:
          type: array
          items:
            type: integer
        description: Lọc theo channel_id (nhiều giá trị)
      - in: query
        name: customer_type
        schema:
          type: string
        description: '''new'' | ''old'''
      - in: query
        name: date_from
        schema:
          type: string
        description: YYYY-MM-DD
      - in: query
        name: date_to
        schema:
          type: string
        description: YYYY-MM-DD
      - in: query
        name: interaction
        schema:
          type: string
        description: '''none'' | ''recent'''
      - in: query
        name: limit
        schema:
          type: integer
        description: Mặc định 20, tối đa 100
      - in: query
        name: offset
        schema:
          type: integer
        description: Mặc định 0
      - in: query
        name: operation_bucket
        schema:
          type: string
        description: 'Lọc theo bucket state tác nghiệp: ''overdue'' | ''today'' |
          ''upcoming'' | ''ended'' | ''none'''
      - in: query
        name: order_source
        schema:
          type: array
          items:
            type: string
        description: Lọc theo order_source (nhiều giá trị)
      - in: query
        name: product
        schema:
          type: array
          items:
            type: integer
        description: Lọc theo product_id (nhiều giá trị)
      - in: query
        name: q
        schema:
          type: string
        description: Tìm theo tên/SĐT khách
      - in: query
        name: staff
        schema:
          type: array
          items:
            type: integer
        description: Lọc theo staff_id (nhiều giá trị)
      tags:
      - sale
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ContactListResponse'
          description: ''
