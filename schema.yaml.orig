          maxLength: 32
        source_note:
          type: string
        note:
          type: string
        created_by_name:
          type: string
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        posted_at:
          type: string
          format: date-time
          nullable: true
        scan_batch_id:
          type: string
          format: uuid
          nullable: true
        lines:
          type: array
          items:
            $ref: '#/components/schemas/ReturnNoteLine'
          readOnly: true
        return_note:
          allOf:
          - $ref: '#/components/schemas/ReturnNoteBrief'
          readOnly: true
      required:
      - created_at
      - created_by_name
      - id
      - lines
      - return_note
      - source_order_invoice_code
