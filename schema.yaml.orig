      - adjustment
      - transfer
      type: string
      description: |-
        * `receipt` - receipt
        * `issue` - issue
        * `adjustment` - adjustment
        * `transfer` - transfer
    Customer:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        code:
          type: string
          description: Mã khách hàng
          maxLength: 50
        full_name:
          type: string
        phone_raw:
          type: string
        phone_normalized:
          type: string
        gender:
          nullable: true
          description: |-
            0: Female, 1: Male

            * `0` - Female
            * `1` - Male
          minimum: -32768
          maximum: 32767
          oneOf:
          - $ref: '#/components/schemas/CustomerGenderEnum'
          - $ref: '#/components/schemas/NullEnum'
        created_at:
          type: string
          format: date-time
