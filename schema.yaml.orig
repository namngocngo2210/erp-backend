          maxLength: 100
        full_name:
          type: string
          maxLength: 255
        phone:
          type: string
          maxLength: 30
        email:
          type: string
          format: email
          maxLength: 255
        note:
          type: string
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - full_name
      - id
      - invoice_code
      - phone
      - source
    WarrantyRegistrationSourceEnum:
      enum:
      - tiktok
      - shopee
      - facebook
      type: string
      description: |-
        * `tiktok` - TikTok
        * `shopee` - Shopee
        * `facebook` - Facebook
    WebphoneTokenResponse:
      type: object
