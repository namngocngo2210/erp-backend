    KiotVietChannel:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          nullable: true
          title: Channel Name
          maxLength: 255
        branch_id:
          type: string
          nullable: true
          maxLength: 100
        branch_ids:
          type: array
          items:
            type: string
        branch_names:
          type: array
          items:
            type: string
          description: Tên chi nhánh, khớp thứ tự với branch_ids (branch_names[i]
            là tên của branch_ids[i])
        old_sync_branch_id:
          type: string
          nullable: true
          description: Branch ID dùng khi đồng bộ từ kênh mới sang kênh Kiot cũ đã
            ghép. Fallback khi kho nguồn không có trong old_sync_branch_map.
          maxLength: 100
        old_sync_branch_map:
          description: 'Danh sách cặp kho đồng bộ new→old: [{"source_branch_id": "...",
            "target_branch_id": "..."}]. source_branch_id thuộc branch_ids của kênh
            này, target_branch_id thuộc kênh Kiot cũ đã ghép.'
        client_id:
          type: string
          nullable: true
          maxLength: 255
        client_secret:
          type: string
          nullable: true
          maxLength: 255
        retailer:
          type: string
          maxLength: 255
        username:
          type: string
          nullable: true
          maxLength: 255
        password:
          type: string
          nullable: true
          maxLength: 255
        old:
          type: boolean
          title: Old Channel
        vat_tax_id:
          type: integer
          maximum: 2147483647
          minimum: 0
          nullable: true
          description: Mã thuế KiotViet gắn cho dòng hàng khi đẩy đơn (vd 3 = VAT
            8%). Để trống = kênh không áp VAT.
        paired_old_channel_id:
          type: integer
          readOnly: true
          nullable: true
        paired_old_channel_name:
          type: string
          readOnly: true
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - paired_old_channel_id
      - paired_old_channel_name
      - retailer
    KiotVietChannelBulkDeleteResponse:
      type: object
      properties:
        deleted_count:
          type: integer
      required:
      - deleted_count
    KiotVietChannelCreate:
      type: object
      properties:
        name:
          type: string
          maxLength: 255
        branch_id:
          type: string
          default: ''
          maxLength: 100
        branch_ids:
          type: array
          items:
            type: string
            maxLength: 100
        branch_names:
          type: array
          items:
            type: string
            maxLength: 255
        old_sync_branch_id:
          type: string
          default: ''
          maxLength: 100
        old_sync_branch_map:
          type: array
          items:
            $ref: '#/components/schemas/OldSyncBranchPair'
        client_id:
          type: string
          maxLength: 255
        client_secret:
          type: string
          maxLength: 255
        retailer:
          type: string
          maxLength: 255
        username:
          type: string
          default: ''
          maxLength: 255
        password:
          type: string
          default: ''
          maxLength: 255
        old:
          type: boolean
          default: false
          description: Kiot cũ
        vat_tax_id:
          type: integer
          minimum: 1
          nullable: true
          description: Mã thuế KiotViet gắn cho dòng hàng khi đẩy đơn (vd 3 = VAT
            8%). Trống = không áp VAT.
        paired_old_channel_id:
          type: integer
          nullable: true
      required:
      - client_id
      - client_secret
      - name
      - retailer
