          application/x-www-form-urlencoded:
            schema:
              type: object
              additionalProperties: {}
          multipart/form-data:
            schema:
              type: object
              additionalProperties: {}
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: Trạng thái kết nối Pancake (không trả token)
        '400':
          description: Token rỗng hoặc Pancake từ chối
  /api/pancake/leads:
    get:
      operationId: pancake_leads_retrieve
      parameters:
      - in: query
        name: channel
        schema:
          type: integer
        description: Lọc theo id kênh bán
      - in: query
        name: date_from
        schema:
          type: string
          format: date
        description: created_at >= ngày
      - in: query
        name: date_to
        schema:
          type: string
          format: date
        description: created_at <= ngày
      - in: query
        name: limit
        schema:
          type: integer
        description: Mặc định 50, tối đa 200
      - in: query
        name: offset
        schema:
          type: integer
      - in: query
        name: page
        schema:
          type: integer
        description: Lọc theo id page
      - in: query
        name: push_status
        schema:
          type: string
        description: pending | ok | failed | skipped_no_mapping | order_created |
          order_failed | order_exists
      - in: query
        name: q
        schema:
          type: string
        description: Tìm theo sđt (chứa) hoặc tên (không phân biệt hoa thường)
      tags:
      - pancake
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: '{items, total, limit, offset}'
  /api/pancake/leads/{id}/retry-order:
    post:
      operationId: pancake_leads_retry_order_create
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - pancake
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '202':
          description: Đã xếp lịch tạo lại đơn
        '404':
          description: Không tìm thấy lead
        '409':
          description: Lead đã có đơn hoặc không ở trạng thái tạo lại được
  /api/pancake/pages:
    get:
      operationId: pancake_pages_retrieve
      tags:
      - pancake
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
