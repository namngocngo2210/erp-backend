                items:
                  $ref: '#/components/schemas/OrderSearchResult'
          description: ''
  /api/orders/sheet3:
    post:
      operationId: orders_sheet3_create
      description: |-
        Danh sách Sheet 3 — đơn thiếu thông tin (không có địa chỉ/tên/SĐT),
        nguồn bất kỳ trừ KOC, chưa "archived". Đơn đã chốt (closed/closed_express/...)
        vẫn nằm trong board — chỉ "archived" (cron autoclose_followups) mới loại đơn
        ra khỏi board (yêu cầu 2026-08-11).
        Trả thêm temperature (hot/warm/cold), contact_count, last_contact_at cho mỗi dòng
        và temperature_counts tổng toàn bộ tập (không chỉ trang hiện tại).
      tags:
      - orders
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Sheet3OrdersRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Sheet3OrdersRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Sheet3OrdersRequest'
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Sheet3OrdersResponse'
          description: ''
        '500':
          description: Lỗi truy vấn/serialize danh sách Sheet 3
  /api/orders/shipments:
    post:
