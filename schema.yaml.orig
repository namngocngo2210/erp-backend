        customer_name:
          type: string
          default: ''
        customer_phone:
          type: string
          default: ''
        source_note:
          type: string
          default: ''
        note:
          type: string
          default: ''
        scan_batch_id:
          type: string
          format: uuid
          nullable: true
        lines:
          type: array
          items:
            $ref: '#/components/schemas/_ReturnLineInput'
