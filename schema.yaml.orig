          readOnly: true
        return_shipping_fee:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
          readOnly: true
        return_order_date:
          type: string
          format: date
          readOnly: true
          nullable: true
        return_tracking_code:
          type: string
          readOnly: true
        return_status:
          allOf:
          - $ref: '#/components/schemas/ReturnStatusEnum'
          readOnly: true
        feedback_agree_review:
          allOf:
          - $ref: '#/components/schemas/FeedbackAgreeReviewEnum'
          readOnly: true
        feedback_rating:
          allOf:
          - $ref: '#/components/schemas/FeedbackRatingEnum'
