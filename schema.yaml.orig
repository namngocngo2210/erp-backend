        transcript:
          type: string
        sales_status:
          type: string
          nullable: true
        not_closed_reason:
          type: string
          nullable: true
    ContactLogResponse:
      type: object
      properties:
        ok:
          type: boolean
      required:
      - ok
    ContactOperation:
      type: object
      description: |-
        Block state tác nghiệp CSKH của khách (module contact_flow) — khách chưa vào
        flow trả stage_name/stage_color rỗng, allow_edit_due=False, due_at=None,
        bucket="none" (KHÔNG dùng bucket_of(None)="ended", xem ContactListService).
      properties:
        stage_name:
          type: string
        stage_color:
          type: string
        allow_edit_due:
          type: boolean
        due_at:
          type: string
          format: date-time
          nullable: true
        bucket:
          $ref: '#/components/schemas/BucketEnum'
      required:
      - allow_edit_due
      - bucket
      - due_at
      - stage_color
      - stage_name
    ContactOrderItem:
      type: object
      description: |-
        1 dòng hàng của đơn. Đơn không có OrderItem (đơn import cũ / đơn tạo
        trước khi có OrderItem — đơn sàn TMĐT đã bị loại khỏi danh sách contact)
        được suy từ chuỗi gộp Order.sku nên product_name rỗng và quantity = 0.
      properties:
        sku:
          type: string
        product_name:
          type: string
        quantity:
          type: integer
      required:
      - product_name
      - quantity
      - sku
    Contract:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        contract_no:
          type: string
          maxLength: 50
        contract_type:
          $ref: '#/components/schemas/ContractTypeEnum'
        start_date:
          type: string
          format: date
        end_date:
          type: string
          format: date
          nullable: true
        base_salary:
          type: string
          format: decimal
          pattern: ^-?\d{0,12}(?:\.\d{0,0})?$
        file_url:
          type: string
          maxLength: 500
        note:
          type: string
          maxLength: 255
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - contract_type
      - created_at
      - id
      - start_date
    ContractSign:
      type: object
      properties:
        contract_type:
          $ref: '#/components/schemas/ContractTypeEnum'
        start_date:
          type: string
          format: date
        end_date:
          type: string
          format: date
          nullable: true
        base_salary:
          type: integer
          minimum: 0
          default: 0
        contract_no:
          type: string
          default: ''
        file_url:
          type: string
          default: ''
        note:
          type: string
          default: ''
      required:
      - contract_type
      - start_date
    ContractTypeEnum:
      enum:
      - probation
      - official
      - seasonal
      - collaborator
      type: string
      description: |-
        * `probation` - Thử việc
        * `official` - Chính thức
        * `seasonal` - Thời vụ
        * `collaborator` - Cộng tác viên
    Coverage:
      type: object
