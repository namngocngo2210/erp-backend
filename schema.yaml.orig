    WarrantyJourneyStatusEnum:
      enum:
      - new
      - created
      - packed
      - shipping
      - lost
      - delivered
      - pending_return
      - returned
      type: string
      description: |-
        * `new` - Mới
        * `created` - Đã lên đơn
        * `packed` - Đã đóng hàng
        * `shipping` - Đang giao
        * `lost` - Thất lạc
        * `delivered` - GTC
        * `pending_return` - Chờ kho xác nhận
        * `returned` - Đã nhận hàng hoàn
    WarrantyJourneyVcGroups:
      type: object
      properties:
        new:
          type: string
          nullable: true
        recall:
          type: string
          nullable: true
        return:
          type: string
          nullable: true
        main:
          type: string
      required:
      - main
      - new
      - recall
      - return
    WarrantyRegistration:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        source:
          $ref: '#/components/schemas/WarrantyRegistrationSourceEnum'
        invoice_code:
