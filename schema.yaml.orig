      - quantity
      - return_type
    _ReturnLineInputReturnTypeEnum:
      enum:
      - delivery_returned
      - external_return
      - warranty
      - defect
      type: string
      description: |-
        * `delivery_returned` - delivery_returned
        * `external_return` - external_return
        * `warranty` - warranty
        * `defect` - defect
    _Row:
      type: object
      properties:
        user_id:
          type: integer
