        is_generating:
          type: boolean
          readOnly: true
        generated_count:
          type: integer
          readOnly: true
        product_id:
          type: integer
          readOnly: true
          nullable: true
        product_name:
          type: string
          readOnly: true
        product_sku:
          type: string
          readOnly: true
        parent_id:
          type: integer
          readOnly: true
          nullable: true
        created_by_name:
          type: string
          readOnly: true
        assigned_by_name:
          type: string
          readOnly: true
        assigned_at:
          type: string
          format: date-time
          nullable: true
        exported_at:
          type: string
          format: date-time
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - assigned_by_name
      - batch_code
      - created_at
      - created_by_name
      - end_seq
      - end_serial
      - generated_count
      - id
      - is_generating
      - parent_id
      - product_id
      - product_name
      - product_sku
      - quantity
      - start_seq
      - start_serial
    WarrantyCodeBatchListResponse:
