    ChannelType:
      type: object
      description: Danh mục loại kênh cho dropdown ở trang Quản lý kênh.
      properties:
        id:
          type: integer
          readOnly: true
        code:
          type: string
          description: Mã loại kênh, ổn định giữa các môi trường (shopee/tiktok/facebook/web).
          maxLength: 50
          pattern: ^[-a-zA-Z0-9_]+$
        name:
          type: string
          description: Tên hiển thị trên giao diện.
          maxLength: 100
        sort_order:
          type: integer
          maximum: 2147483647
          minimum: 0
          description: Thứ tự hiển thị trong dropdown; nhỏ hơn đứng trước.
        is_active:
          type: boolean
          description: Tắt để ẩn khỏi dropdown mà không xoá dữ liệu kênh đã gán.
        channel_count:
          type: integer
          description: |-
            Số kênh đang gán loại này — FE dùng để cảnh báo trước khi xoá.

            Đọc từ annotate của repository khi có (danh sách), fallback query lẻ cho
            instance rời (response của POST/PATCH chỉ có 1 dòng nên không phải N+1).
          readOnly: true
      required:
      - channel_count
      - code
      - id
      - name
    ChannelTypeCreate:
      type: object
      description: Tạo loại kênh. ``code`` bắt buộc và duy nhất; đặt xong là KHOÁ
        (xem update).
      properties:
        code:
          type: string
          description: Mã loại kênh, ổn định giữa các môi trường (shopee/tiktok/facebook/web).
          maxLength: 50
          pattern: ^[-a-zA-Z0-9_]+$
        name:
          type: string
          description: Tên hiển thị trên giao diện.
          maxLength: 100
        sort_order:
          type: integer
          maximum: 2147483647
          minimum: 0
          description: Thứ tự hiển thị trong dropdown; nhỏ hơn đứng trước.
        is_active:
          type: boolean
          description: Tắt để ẩn khỏi dropdown mà không xoá dữ liệu kênh đã gán.
      required:
      - code
      - name
