      - email
      - token
      - ttl
    WorkTypeEnum:
      enum:
      - fulltime
      - parttime
      - remote
      type: string
      description: |-
        * `fulltime` - Toàn thời gian
        * `parttime` - Bán thời gian
        * `remote` - Remote
    _AdjustLineInput:
      type: object
      properties:
        product_id:
          type: integer
        quantity:
          type: integer
          minimum: 0
      required:
      - product_id
      - quantity
    _Config:
      type: object
      properties:
        enabled:
          type: boolean
        stale_days:
          type: integer
          maximum: 365
          minimum: 1
        saved_status_codes:
          type: array
          items:
            type: string
            maxLength: 64
        max_float_count:
          type: integer
          maximum: 1000
          minimum: 1
        daily_claim_limit:
          type: integer
          maximum: 1000
          minimum: 0
        max_order_age_days:
          type: integer
          maximum: 3650
          minimum: 0
        hide_phone:
          type: boolean
      required:
      - daily_claim_limit
      - enabled
      - hide_phone
      - max_float_count
      - max_order_age_days
      - saved_status_codes
      - stale_days
    _Copy:
      type: object
      properties:
        date:
          type: string
          format: date
    _DispatchInput:
      type: object
      properties:
        order_ids:
          type: array
          items:
            type: integer
            minimum: 1
          maxItems: 200
        warehouse_id:
          type: integer
          minimum: 1
      required:
      - order_ids
      - warehouse_id
    _LineInput:
      type: object
      properties:
        product_id:
          type: integer
        quantity:
          type: integer
          minimum: 1
      required:
      - product_id
      - quantity
    _ReturnLineInput:
