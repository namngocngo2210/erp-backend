      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: Đã đánh dấu
  /api/inventory/flow-pending/{scan_id}/match:
    post:
      operationId: inventory_flow_pending_match_create
      description: |-
        Khớp mã chờ khớp với đơn người dùng chọn (xuất kho / tạo phiếu trả).

        Hành vi GHI nên decorator đòi quyền :edit (xem khối chú thích trên). HÀNH
        ĐỘNG khớp thực sự xuất kho (kind=dispatch) hoặc tạo/ghi phiếu trả
        (kind=return) — vẫn soi thêm đúng section theo kind như luồng quét chuẩn
        (pending_scan_views.py dùng "shipments", return_views.py dùng "returns").
      parameters:
      - in: path
        name: scan_id
        schema:
          type: integer
        required: true
      tags:
      - inventory
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/FlowManualMatchRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/FlowManualMatchRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/FlowManualMatchRequest'
        required: true
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/FlowManualMatchResult'
          description: ''
  /api/inventory/flow-pending/{scan_id}/note:
    patch:
      operationId: inventory_flow_pending_note_partial_update
      description: Sửa ghi chú của một dòng mã chờ khớp ngay trên trang Lịch sử nhập
        xuất.
      parameters:
      - in: path
        name: scan_id
        schema:
          type: integer
        required: true
      tags:
