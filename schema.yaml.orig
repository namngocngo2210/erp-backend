          readOnly: true
        order_date:
          type: string
          format: date
          readOnly: true
          nullable: true
        new_tracking_code:
          type: string
          readOnly: true
        recall_code:
          type: string
          readOnly: true
        note:
          type: string
          readOnly: true
        warehouse_received_at:
          type: string
          format: date
          readOnly: true
          nullable: true
        inspection_result:
