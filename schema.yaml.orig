        required: true
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ParseImportLinesResponse'
          description: ''
        '400':
          description: Thiếu file hoặc file không đọc được
