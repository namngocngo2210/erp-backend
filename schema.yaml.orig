  /api/orders/lookup-address:
    post:
      operationId: orders_lookup_address_create
      description: Địa chỉ thô → địa chỉ 3 cấp (63 tỉnh) và 2 cấp (34 tỉnh, sau 01/07/2025).
      tags:
      - orders
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LookupAddressRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/LookupAddressRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/LookupAddressRequest'
        required: true
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LookupAddressResponse'
          description: ''
  /api/orders/lookup-by-shipping-code:
    get:
      operationId: orders_lookup_by_shipping_code_retrieve
      parameters:
      - in: query
        name: code
        schema:
          type: string
        description: Mã vận đơn hoặc mã thu hồi
        required: true
      - in: query
        name: invoice_match
        schema:
          type: string
        description: '''1'' để bật khớp thêm theo MÃ HOÁ ĐƠN (mode=dispatch only).
          Cờ triển khai: chỉ frontend bản MỚI (biết đọc `matched_by` và tự chọn kho
          theo đường khớp) mới gửi cờ này — một tab quét cũ để mở qua lúc deploy sẽ
          không gửi và tiếp tục nhận hình dạng response CŨ, tránh nhận nhầm đơn khớp
          invoice rồi trừ tồn ở kho màn quét qua dispatch-batch. Gỡ cờ này khi không
          còn bundle cũ nào lưu hành.'
      - in: query
        name: mode
        schema:
          type: string
          enum:
          - dispatch
          - return
          - return_scan
        description: 'dispatch (mặc định): xác minh realtime với KiotViet, chặn đơn
          đã hủy. return: không xác minh (đơn hủy vẫn được nhập hoàn) — dùng cho màn
          kéo dòng hàng của đơn vào phiếu kho thủ công. return_scan: như return, THÊM
          chặn mã đã có lần nhập hoàn còn sống — dùng cho quét nhập hoàn.'
      tags:
      - orders
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ShippingLookupOrder'
          description: ''
        '400':
          description: Thiếu code
        '404':
          description: 'Không tìm thấy đơn theo mã vận đơn. Nếu mã đang chờ khớp (bảng
            PendingShipmentScan), body kèm thêm `pending_scan: {kind, created_at}`.'
        '409':
          description: '`order_cancelled`: đơn đã hủy trên KiotViet — không cho xuất
            kho. `return_already_scanned` (mode=return_scan): mã đã có lần nhập hoàn
            còn sống, body kèm `note_code` (mã phiếu, rỗng nếu mã còn chờ khớp).'
        '503':
          description: Không xác minh được với KiotViet — chặn quét (fail-closed).
