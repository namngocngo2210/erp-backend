    ReturnEntry:
      type: object
      description: Nhóm đơn hoàn. `note` = ghi chú của nhóm đơn; phiếu ngày nằm ở
        `return_note`.
      properties:
        id:
          type: integer
          readOnly: true
        status:
          $ref: '#/components/schemas/ReturnEntryStatusEnum'
        source_order:
          type: integer
          nullable: true
