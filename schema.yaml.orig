      - batch_code
      - batch_id
      - code
      - created_at
      - id
      - product_id
      - product_name
      - product_sku
      - seq
      - serial
      - status
    WarrantyCodeBatch:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        batch_code:
          type: string
          maxLength: 32
        start_seq:
          type: integer
          maximum: 9223372036854775807
          minimum: -9223372036854775808
          format: int64
        end_seq:
          type: integer
          maximum: 9223372036854775807
          minimum: -9223372036854775808
          format: int64
        start_serial:
          type: string
          readOnly: true
        end_serial:
          type: string
          readOnly: true
        quantity:
          type: integer
          maximum: 2147483647
          minimum: 0
        status:
