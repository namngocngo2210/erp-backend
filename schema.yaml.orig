    MeResponse:
      type: object
      description: |-
        Schema payload user đầy đủ (UserSerializer + RBAC) — dùng chung /me và /login.

        Một class duy nhất (không dùng inline_serializer 2 lần) để tránh trùng tên
        component trong OpenAPI schema.
      properties:
        id:
