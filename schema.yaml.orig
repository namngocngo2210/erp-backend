    OrderList:
      type: object
      description: |-
        Bản gọn của OrderSerializer cho các trang danh sách đơn.

        Pop field trong __init__ thay vì khai Meta.fields riêng: DRF không cho subclass
        bỏ field đã declare khỏi Meta.fields, còn pop khỏi ``self.fields`` thì field bị
        loại khỏi cả vòng to_representation (tiết kiệm CPU thật) lẫn schema OpenAPI.
        Với many=True child chỉ bind một lần nên pop cũng chỉ chạy một lần mỗi trang.
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 255
        phone:
          type: string
          maxLength: 30
        raw_address:
          type: string
        address:
          type: string
        has_address:
          type: boolean
        kiotviet_location:
          type: string
          maxLength: 255
        kiotviet_ward:
          type: string
          maxLength: 255
        product:
          type: string
        sku:
          type: string
        quantity:
          type: integer
          maximum: 2147483647
          minimum: 0
        items:
          type: array
          items:
            $ref: '#/components/schemas/OrderItem'
          readOnly: true
        channel_code:
          type: string
          readOnly: true
        channel_name:
          type: string
          readOnly: true
        channel_type:
          type: string
          readOnly: true
          nullable: true
        channel_type_name:
          type: string
          readOnly: true
          nullable: true
        kiotviet_channel_id:
          type: integer
          readOnly: true
          nullable: true
        kiotviet_name:
          type: string
          readOnly: true
          nullable: true
        staff_id:
          type: integer
          readOnly: true
          nullable: true
        staff_name:
          type: string
          nullable: true
          readOnly: true
        status:
          allOf:
          - $ref: '#/components/schemas/Status22fEnum'
          minimum: 0
          maximum: 32767
        weight:
          type: string
          format: decimal
          pattern: ^-?\d{0,7}(?:\.\d{0,3})?$
        dimensions:
          type: string
          maxLength: 255
        branch_id:
          type: string
          maxLength: 100
        order_type:
          $ref: '#/components/schemas/OrderTypeEnum'
        koc_order_type:
          oneOf:
          - $ref: '#/components/schemas/KocOrderTypeEnum'
          - $ref: '#/components/schemas/BlankEnum'
        order_source:
          nullable: true
          oneOf:
          - $ref: '#/components/schemas/OrderSourceEnum'
          - $ref: '#/components/schemas/BlankEnum'
          - $ref: '#/components/schemas/NullEnum'
        vat:
          $ref: '#/components/schemas/VatEnum'
        is_export_vat:
          type: boolean
        vat_link:
          type: string
          maxLength: 500
        return_date:
          type: string
          format: date
          nullable: true
        show_orders:
          type: boolean
        customer_prepaid:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
        invoice_code:
          type: string
          maxLength: 100
        invoice_status:
          type: integer
          maximum: 32767
          minimum: 0
          nullable: true
        is_delivery_invoice_printed:
          type: boolean
        customer_return:
          type: boolean
        old_invoice_code:
          type: string
          maxLength: 100
        total_after_discount:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
        total_amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
        payment_method:
          type: string
          maxLength: 100
        shipping_code:
          type: string
          maxLength: 100
        customer_phone:
          type: string
          readOnly: true
        customer_code:
          type: string
          readOnly: true
        customer_gender:
          type: string
          readOnly: true
        customer_is_new:
          type: boolean
          readOnly: true
        crm:
          type: object
          additionalProperties: {}
          nullable: true
          readOnly: true
        recall:
          type: object
          additionalProperties: {}
          nullable: true
          readOnly: true
        recall_entries:
          type: array
          items:
            type: object
            additionalProperties: {}
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        sales_closed_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        can_edit:
          type: string
          readOnly: true
        is_invoice_locked:
          type: boolean
          readOnly: true
        is_kiotviet_processing:
          type: boolean
          readOnly: true
        latest_kiotviet_job_status:
          type: string
          nullable: true
          readOnly: true
        latest_kiotviet_job_error:
          type: string
          nullable: true
          readOnly: true
        shipping_provider:
          type: string
          maxLength: 50
        fulfillment_warehouse:
          type: integer
          nullable: true
        shipping_type:
          nullable: true
          oneOf:
          - $ref: '#/components/schemas/ShippingTypeEnum'
          - $ref: '#/components/schemas/BlankEnum'
          - $ref: '#/components/schemas/NullEnum'
        duplicate_order_ids:
          type: array
          items:
            type: integer
          description: |-
            Id các đơn khớp ĐANG VẬN CHUYỂN (cùng SĐT + cùng sản phẩm, ≤30 ngày).

            Map dựng sẵn MỘT lần cho cả trang trong `_build_order_list_context`
            (xem `order_duplicate_warning_service`); ở đây chỉ tra cứu — KHÔNG tự
            query, để một chỗ nào đó serialize many=True thiếu context không biến
            thành N+1.
          readOnly: true
        returning_order_ids:
          type: array
          items:
            type: integer
          description: |-
            Id các đơn khớp ĐANG/ĐÃ HOÀN — cảnh báo nguy cơ bom hàng, khác nghiệp
            vụ với `duplicate_order_ids` nên tách hẳn field thay vì gộp một danh sách.
          readOnly: true
      required:
      - can_edit
      - channel_code
      - channel_name
      - channel_type
      - channel_type_name
      - created_at
      - crm
      - customer_code
      - customer_gender
      - customer_is_new
      - customer_phone
      - duplicate_order_ids
      - id
      - is_invoice_locked
      - is_kiotviet_processing
      - items
      - kiotviet_channel_id
      - kiotviet_name
      - latest_kiotviet_job_error
      - latest_kiotviet_job_status
      - recall
      - recall_entries
      - returning_order_ids
      - sales_closed_at
      - staff_id
      - staff_name
