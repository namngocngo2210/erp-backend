          readOnly: true
        compensation_amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
          readOnly: true
        new_tracking_best_status:
          type: string
          readOnly: true
        recall_best_status:
          type: string
          readOnly: true
        return_tracking_best_status:
          type: string
          readOnly: true
