        order_id:
          type: integer
          writeOnly: true
        customer_report_date:
          type: string
          format: date
          nullable: true
        activation_date:
          type: string
          format: date
          nullable: true
        warranty_months:
          type: integer
          maximum: 32767
          minimum: 0
        status:
          allOf:
          - $ref: '#/components/schemas/StatusD2aEnum'
          minimum: 0
          maximum: 32767
    WarrantyCode:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        seq:
          type: integer
          maximum: 9223372036854775807
          minimum: -9223372036854775808
          format: int64
        serial:
          type: string
          maxLength: 20
        code:
          type: string
          maxLength: 10
        batch_id:
          type: integer
          readOnly: true
        batch_code:
          type: string
          readOnly: true
        product_id:
          type: integer
          readOnly: true
          nullable: true
        product_name:
          type: string
          readOnly: true
        product_sku:
          type: string
          readOnly: true
        status:
          type: string
          readOnly: true
        created_at:
          type: string
          format: date-time
