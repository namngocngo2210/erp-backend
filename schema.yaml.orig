      - total_orders
      - unreachable_count
    CustomerProfile:
      type: object
      description: |-
        Hồ sơ 360 của một khách — mirror `_PROFILE_COLUMNS` + `full_name`.

        Ba nhóm trường xếp theo độ phủ giảm dần: định danh & hành vi mua (phủ ~100%),
        chân dung suy từ hành vi (phủ theo số đơn GTC), rồi chân dung khai báo
        (phủ dưới 2% — xem `coverage()`). Tầng hiển thị ẩn hẳn nhóm cuối khi rỗng.
      properties:
        customer_id:
          type: integer
        code:
          type: string
          nullable: true
        full_name:
          type: string
          nullable: true
        gender:
          type: string
          nullable: true
        created_at:
          type: string
          format: date-time
          nullable: true
        is_new_customer:
          type: boolean
          nullable: true
        segment_code:
          type: string
          nullable: true
        segment_name:
          type: string
          nullable: true
        care_priority:
          type: string
          nullable: true
        has_problem:
          type: boolean
          nullable: true
        latest_sales_status_code:
          type: string
          nullable: true
        orders_gtc:
          type: integer
        orders_all:
          type: integer
        orders_cancelled:
          type: integer
        total_spent:
          type: string
          format: decimal
          pattern: ^-?\d{0,12}(?:\.\d{0,2})?$
        avg_order_value:
          type: number
          format: double
          nullable: true
        first_purchase_at:
          type: string
          format: date-time
          nullable: true
        last_purchase_at:
          type: string
          format: date-time
          nullable: true
        days_since_last_purchase:
          type: integer
          nullable: true
        repurchase_gap_median_days:
          type: number
          format: double
          nullable: true
        channels:
          type: array
          items:
            type: string
        provinces:
          type: array
          items:
            type: string
        top_skus:
          type: array
          items:
            type: string
        distinct_products:
          type: integer
        call_count:
          type: integer
        avg_quality_score:
          type: number
          format: double
          nullable: true
        era:
          type: string
          nullable: true
        price_tier_lifetime:
          type: string
          nullable: true
        purchase_rhythm_lifetime:
          type: string
          nullable: true
        recency_bucket:
          type: string
          nullable: true
        channel_affinity:
          type: string
          nullable: true
        product_affinity:
          type: string
          nullable: true
        buyer_role:
          type: string
          nullable: true
        age_text:
          type: string
          nullable: true
        age_text_src:
          type: string
          nullable: true
        occupation_code:
          type: string
          nullable: true
        occupation_code_src:
          type: string
          nullable: true
        pain_level_code:
          type: string
          nullable: true
        pain_level_code_src:
          type: string
          nullable: true
        pain_duration_code:
          type: string
          nullable: true
        used_massage_before:
          type: boolean
          nullable: true
        lifestyle_habit_codes:
          type: array
          items:
            type: string
        relax_time_codes:
          type: array
          items:
            type: string
        purchase_barrier_codes:
          type: array
          items:
            type: string
        delax_source_codes:
          type: array
          items:
            type: string
        need_codes:
          type: array
          items:
            type: string
        need_group_codes:
          type: array
          items:
            type: string
        filled_field_count:
          type: integer
        ai_field_count:
          type: integer
      required:
      - age_text
      - age_text_src
      - ai_field_count
      - avg_order_value
      - avg_quality_score
      - buyer_role
      - call_count
      - care_priority
      - channel_affinity
      - channels
      - code
      - created_at
      - customer_id
      - days_since_last_purchase
      - delax_source_codes
      - distinct_products
      - era
      - filled_field_count
      - first_purchase_at
      - full_name
      - gender
      - has_problem
      - is_new_customer
      - last_purchase_at
      - latest_sales_status_code
      - lifestyle_habit_codes
      - need_codes
      - need_group_codes
      - occupation_code
      - occupation_code_src
      - orders_all
      - orders_cancelled
      - orders_gtc
      - pain_duration_code
      - pain_level_code
      - pain_level_code_src
      - price_tier_lifetime
      - product_affinity
      - provinces
      - purchase_barrier_codes
      - purchase_rhythm_lifetime
      - recency_bucket
      - relax_time_codes
      - repurchase_gap_median_days
      - segment_code
      - segment_name
      - top_skus
      - total_spent
      - used_massage_before
