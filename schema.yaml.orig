openapi: 3.0.3
info:
  title: Desi-Order ERP API
  version: 1.0.0
  description: Hợp đồng API nội bộ — sinh tự động từ DRF. Xem docs/tech-stack-evolution-2026.md
    (D7).
paths:
  /api/analytics/coverage:
    get:
      operationId: analytics_coverage_retrieve
      description: Độ phủ từng trường chân dung khách hàng, tách nguồn declared /
        ai.
      tags:
      - analytics
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Coverage'
          description: ''
  /api/analytics/customers:
    get:
      operationId: analytics_customers_retrieve
      description: Tìm khách cho ô chọn của màn Hồ sơ 360.
      parameters:
      - in: query
        name: q
        schema:
          type: string
        description: Chuỗi tìm theo mã khách, tên, hoặc SĐT. Tối thiểu 2 ký tự.
      tags:
      - analytics
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CustomerSearchResponse'
          description: ''
  /api/analytics/customers/{customer_id}:
    get:
      operationId: analytics_customers_retrieve_2
      description: 'Hồ sơ 360 của một khách: chân dung + dòng thời gian mua hàng.'
      parameters:
      - in: path
        name: customer_id
        schema:
          type: integer
        required: true
      tags:
      - analytics
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CustomerProfileResponse'
          description: ''
  /api/audit-logs/:
    get:
      operationId: audit_logs_list
      description: Danh sách audit log phân trang {items,total,limit,offset}.
      parameters:
      - in: query
        name: action_type
        schema:
          type: string
          enum:
          - API_REQUEST
          - CREATE
          - DELETE
          - KIOTVIET_REQUEST
          - LOGIN
          - LOGOUT
          - READ
          - SYSTEM
          - UPDATE
        description: |-
          * `CREATE` - Create
          * `UPDATE` - Update
          * `DELETE` - Delete
          * `READ` - Read
          * `LOGIN` - Login
          * `LOGOUT` - Logout
          * `API_REQUEST` - API Request
          * `KIOTVIET_REQUEST` - KiotViet Request
          * `SYSTEM` - System
      - in: query
        name: entity_id
        schema:
          type: string
      - in: query
        name: entity_type
        schema:
          type: string
          enum:
          - CHANNEL
          - CUSTOMER
          - KIOTVIET_JOB
          - ORDER
          - OTHER
          - PRODUCT
          - USER
        description: |-
          * `ORDER` - Order
          * `CUSTOMER` - Customer
          * `PRODUCT` - Product
          * `USER` - User
          * `CHANNEL` - Channel
          * `KIOTVIET_JOB` - KiotViet Job
          * `OTHER` - Other
      - in: query
        name: limit
        schema:
          type: integer
        description: Số dòng mỗi trang (mặc định 100, tối đa 500).
      - in: query
        name: offset
        schema:
          type: integer
        description: Vị trí bắt đầu (mặc định 0).
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - in: query
        name: search
        schema:
          type: string
        description: Tìm chuỗi con (không phân biệt hoa thường) trên entity_id, username
          người thao tác và ip_address. BẮT BUỘC đi kèm timestamp__gte; cửa sổ [timestamp__gte,
          timestamp__lte] tối đa 31 ngày (bounded scan trên bảng lớn).
      - in: query
        name: source
        schema:
          type: string
          enum:
          - api_request
          - kiotviet
          - user_action
        description: |-
          * `user_action` - User Action
          * `api_request` - API Request
          * `kiotviet` - KiotViet
      - in: query
        name: timestamp
        schema:
          type: string
          format: date-time
      - in: query
        name: timestamp__gte
        schema:
          type: string
          format: date-time
      - in: query
        name: timestamp__lte
        schema:
          type: string
          format: date-time
      - in: query
        name: user
        schema:
          type: integer
      tags:
      - audit-logs
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AuditLogListResponse'
          description: ''
        '400':
          description: limit/offset không hợp lệ; hoặc search thiếu timestamp__gte
            / khoảng thời gian vượt 31 ngày
  /api/audit-logs/{id}/:
    get:
      operationId: audit_logs_retrieve
      description: |-
        API endpoint để xem audit logs
        Chỉ cho phép đọc, không cho phép chỉnh sửa
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this audit log.
        required: true
      tags:
      - audit-logs
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AuditLogList'
          description: ''
  /api/best-express/accounts:
    get:
      operationId: best_express_accounts_list
      tags:
      - best-express
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/BestAccount'
          description: ''
  /api/best-express/estimate-fee:
    post:
      operationId: best_express_estimate_fee
      tags:
      - best-express
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/EstimateFeeRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/EstimateFeeRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/EstimateFeeRequest'
        required: true
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: Kết quả EstimateFee nguyên bản từ Best
  /api/best-express/print-waybill:
    post:
      operationId: best_express_print_waybill
      tags:
      - best-express
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CodesRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CodesRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CodesRequest'
        required: true
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BestPrintWaybillResponse'
          description: ''
  /api/best-express/shipments:
    get:
      operationId: best_express_shipments_list
      tags:
      - best-express
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BestShipmentListResponse'
          description: ''
    post:
      operationId: best_express_shipments_create
      tags:
      - best-express
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CreateShipmentRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CreateShipmentRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CreateShipmentRequest'
        required: true
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BestShipment'
          description: ''
  /api/best-express/shipments/{shipment_id}:
    patch:
      operationId: best_express_shipment_update
      parameters:
      - in: path
        name: shipment_id
        schema:
          type: integer
        required: true
      tags:
      - best-express
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedUpdateShipmentRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedUpdateShipmentRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedUpdateShipmentRequest'
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BestShipment'
          description: ''
        '404':
          description: Không tìm thấy vận đơn
  /api/best-express/shipments/{shipment_id}/address:
    post:
      operationId: best_express_shipment_update_address
      parameters:
      - in: path
        name: shipment_id
        schema:
          type: integer
        required: true
      tags:
      - best-express
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/UpdateAddressRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/UpdateAddressRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/UpdateAddressRequest'
        required: true
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: Kết quả UpdateAddress nguyên bản từ Best
  /api/best-express/shipments/{shipment_id}/cancel:
    post:
      operationId: best_express_shipment_cancel
      parameters:
      - in: path
        name: shipment_id
        schema:
          type: integer
        required: true
      tags:
      - best-express
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BestShipment'
          description: ''
        '404':
          description: Không tìm thấy vận đơn
  /api/best-express/trace:
    post:
      operationId: best_express_trace
      tags:
      - best-express
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CodesRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CodesRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CodesRequest'
        required: true
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: Hành trình vận đơn nguyên bản từ Best (đồng thời sync vào BestShipment)
  /api/callcenter/orders/{order_id}/call-records:
    get:
      operationId: callcenter_order_call_records
      description: Danh sách cuộc gọi Zenify đã khớp với đơn (mới nhất trước).
      parameters:
      - in: path
        name: order_id
        schema:
          type: integer
        required: true
      tags:
      - callcenter
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OrderCallRecordsResponse'
          description: ''
        '404':
          description: Đơn không tồn tại hoặc ngoài scope của user
  /api/callcenter/quality/agents:
    get:
      operationId: call_quality_agents
      description: Điểm TB, điểm làm tốt nhất và cần cải thiện nhất của từng sale.
      parameters:
      - in: query
        name: end
        schema:
          type: string
        description: Ngày kết thúc YYYY-MM-DD (mặc định hôm nay)
      - in: query
        name: min_calls
        schema:
          type: integer
        description: Số cuộc tối thiểu để vào bảng
      - in: query
        name: sales_status
        schema:
          type: string
        description: Mã trạng thái sale hiện tại của đơn
      - in: query
        name: start
        schema:
          type: string
        description: Ngày bắt đầu YYYY-MM-DD (mặc định 30 ngày trước)
      tags:
      - callcenter
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: Điểm theo từng sale phụ trách đơn
  /api/callcenter/quality/calls:
    get:
      operationId: call_quality_calls
      description: Danh sách cuộc gọi đã chấm, lọc được theo điểm/cờ đỏ/tiêu chí yếu.
      parameters:
      - in: query
        name: criterion
        schema:
          type: string
        description: Mã tiêu chí bị 0 điểm
      - in: query
        name: end
        schema:
          type: string
        description: Ngày kết thúc YYYY-MM-DD (mặc định hôm nay)
      - in: query
        name: has_red_flag
        schema:
          type: string
        description: 1 = chỉ cuộc có cờ đỏ
      - in: query
        name: max_score
        schema:
          type: integer
        description: Điểm tổng tối đa
      - in: query
        name: min_score
        schema:
          type: integer
        description: Điểm tổng tối thiểu
      - in: query
        name: page
        schema:
          type: integer
      - in: query
        name: page_size
        schema:
          type: integer
      - in: query
        name: sales_status
        schema:
          type: string
        description: Mã trạng thái sale hiện tại của đơn
      - in: query
        name: sku
        schema:
          type: string
        description: SKU sản phẩm trên đơn
      - in: query
        name: staff
        schema:
          type: integer
        description: ID sale phụ trách đơn
      - in: query
        name: start
        schema:
          type: string
        description: Ngày bắt đầu YYYY-MM-DD (mặc định 30 ngày trước)
      tags:
      - callcenter
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: Danh sách cuộc gọi đã chấm
  /api/callcenter/quality/calls/{score_id}:
    get:
      operationId: call_quality_call_detail
      description: 'Chi tiết 1 cuộc: điểm từng tiêu chí kèm trích dẫn, transcript,
        đối chiếu chéo.'
      parameters:
      - in: path
        name: score_id
        schema:
          type: integer
        required: true
      tags:
      - callcenter
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: Chi tiết điểm 1 cuộc gọi kèm trích dẫn + transcript
        '404':
          description: Không tìm thấy bản chấm
  /api/callcenter/quality/calls/{score_id}/review:
    post:
      operationId: call_quality_review
      description: Ghi nhận 'AI chấm sai' + điểm đúng theo người. KHÔNG ghi đè điểm
        AI.
      parameters:
      - in: path
        name: score_id
        schema:
          type: integer
        required: true
      tags:
      - callcenter
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CallQualityReviewRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CallQualityReviewRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CallQualityReviewRequest'
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '201':
          description: Đã ghi nhận phản hồi
        '400':
          description: Tham số không hợp lệ
        '404':
          description: Không tìm thấy bản chấm
  /api/callcenter/quality/filters:
    get:
      operationId: call_quality_filter_options
      description: Giá trị lọc CÓ THẬT trong kỳ — không đổ toàn bộ danh mục sản phẩm/nhân
        sự về FE.
      parameters:
      - in: query
        name: end
        schema:
          type: string
        description: Ngày kết thúc YYYY-MM-DD (mặc định hôm nay)
      - in: query
        name: sales_status
        schema:
          type: string
        description: Mã trạng thái sale hiện tại của đơn
      - in: query
        name: start
        schema:
          type: string
        description: Ngày bắt đầu YYYY-MM-DD (mặc định 30 ngày trước)
      tags:
      - callcenter
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: Danh sách sale và SKU có trong dữ liệu đã chấm
  /api/callcenter/quality/rubric:
    get:
      operationId: call_quality_rubric
      description: Rubric đang dùng — FE hiển thị nhãn tiêu chí mà không hard-code.
      tags:
      - callcenter
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: Rubric hiện hành
  /api/callcenter/quality/summary:
    get:
      operationId: call_quality_summary
      description: Tổng quan chất lượng cuộc gọi toàn team theo khoảng ngày.
      parameters:
      - in: query
        name: end
        schema:
          type: string
        description: Ngày kết thúc YYYY-MM-DD (mặc định hôm nay)
      - in: query
        name: sales_status
        schema:
          type: string
        description: Mã trạng thái sale hiện tại của đơn
      - in: query
        name: start
        schema:
          type: string
        description: Ngày bắt đầu YYYY-MM-DD (mặc định 30 ngày trước)
      tags:
      - callcenter
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: Thẻ số tổng, điểm từng khối/tiêu chí, độ phủ
  /api/callcenter/quality/trend:
    get:
      operationId: call_quality_trend
      description: Xu hướng điểm theo tuần (tổng + từng khối) để đo hiệu quả đào tạo.
      parameters:
      - in: query
        name: end
        schema:
          type: string
        description: Ngày kết thúc YYYY-MM-DD (mặc định hôm nay)
      - in: query
        name: sales_status
        schema:
          type: string
        description: Mã trạng thái sale hiện tại của đơn
      - in: query
        name: start
        schema:
          type: string
        description: Ngày bắt đầu YYYY-MM-DD (mặc định 30 ngày trước)
      tags:
      - callcenter
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: Điểm trung bình theo tuần
  /api/callcenter/token:
    post:
      operationId: callcenter_webphone_token
      description: Cấp access token Zenify Web SDK cho agent hiện tại. ?refresh=1
        để bỏ cache.
      tags:
      - callcenter
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/WebphoneTokenResponse'
          description: ''
        '400':
          description: User chưa có Email Zenify (zenify_email / email ERP đều rỗng)
        '502':
          description: Zenify trả lỗi (message nguyên văn)
        '503':
          description: Chưa cấu hình Zenify env
  /api/channels/:
    get:
      operationId: channels_list
      tags:
      - channels
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Channel'
          description: ''
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Channel'
          description: ''
        '403':
          description: Không có quyền quản lí kênh
    post:
      operationId: channels_create
      tags:
      - channels
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ChannelCreate'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ChannelCreate'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ChannelCreate'
        required: true
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Channel'
          description: ''
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Channel'
          description: ''
        '403':
          description: Không có quyền quản lí kênh
  /api/channels/{channel_id}:
    patch:
      operationId: channels_partial_update
      parameters:
      - in: path
        name: channel_id
        schema:
          type: integer
        required: true
      tags:
      - channels
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedChannelUpdate'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedChannelUpdate'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedChannelUpdate'
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Channel'
          description: ''
        '204':
          description: DELETE thành công
        '403':
          description: Không có quyền quản lí kênh
    delete:
      operationId: channels_destroy
      parameters:
      - in: path
        name: channel_id
        schema:
          type: integer
        required: true
      tags:
      - channels
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Channel'
          description: ''
        '204':
          description: DELETE thành công
        '403':
          description: Không có quyền quản lí kênh
  /api/channels/{channel_id}/assignments:
    get:
      operationId: channels_assignments_list
      parameters:
      - in: path
        name: channel_id
        schema:
          type: integer
        required: true
      tags:
      - channels
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
