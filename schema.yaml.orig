      properties:
        account_id:
          type: integer
          nullable: true
        order_id:
          type: integer
          nullable: true
        payload:
          type: object
          additionalProperties: {}
          description: Payload Order/Add nguyên bản theo tài liệu Best V3
      required:
      - payload
    CreateStockDocument:
      type: object
      properties:
        doc_type:
          $ref: '#/components/schemas/CreateStockDocumentDocTypeEnum'
        source_warehouse_id:
          type: integer
