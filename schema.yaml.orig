  /api/channels/me/assignments:
    get:
      operationId: channels_me_assignments_list
      description: |-
        Return the current user's assigned channels.

        Only ads-department staff have a restricted channel scope; other users get
        an empty list so the frontend treats them as unrestricted.
      tags:
      - channels
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
