      description: |-
        Tổng hợp chi phí theo từng customer của một config trong khoảng thời gian.

        Mirror của FB daily_spend_summary. Nhận date_preset hoặc since/until,
        đọc từ bảng GoogleAdsAccountDailySpend (do cron/sync đã ghi sẵn).
      parameters:
      - in: path
        name: config_id
        schema:
          type: integer
        required: true
      tags:
      - google-ads
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GoogleAdsDailySpendSummaryResponse'
          description: ''
        '400':
          description: Ngày/preset/account_ids không hợp lệ
        '404':
          description: Không tìm thấy cấu hình Google Ads
