    PatchedEmployeeUpdate:
      type: object
      description: |-
        Validates PATCH payloads for an employee and normalizes them to the
        field names expected by ``EmployeeService.update``'s whitelist.

        The read serializer (``EmployeeSerializer``) exposes the relations as
        ``department`` / ``manager`` (FK ids), so a client that GETs then PATCHes
        back would send those read-shape keys. To make the round-trip work we
        accept both shapes: ``to_internal_value`` maps incoming ``department`` ->
        ``department_id`` and ``manager`` -> ``manager_id`` (only when the canonical
        key is absent) before normal field validation runs.
      properties:
        full_name:
          type: string
        employee_code:
          type: string
          maxLength: 20
        department_id:
          type: integer
          nullable: true
        manager_id:
          type: integer
          nullable: true
        job_title:
          oneOf:
          - $ref: '#/components/schemas/JobTitleEnum'
          - $ref: '#/components/schemas/BlankEnum'
        employment_status:
          $ref: '#/components/schemas/EmploymentStatusEnum'
        position_level:
          oneOf:
          - $ref: '#/components/schemas/PositionLevelEnum'
          - $ref: '#/components/schemas/BlankEnum'
        position_title:
          type: string
        work_type:
          oneOf:
          - $ref: '#/components/schemas/WorkTypeEnum'
          - $ref: '#/components/schemas/BlankEnum'
        lark_account:
          type: string
        hire_date:
          type: string
          format: date
          nullable: true
        official_date:
          type: string
          format: date
          nullable: true
        resign_date:
          type: string
          format: date
          nullable: true
        resign_reason:
          type: string
        personal_email:
          type: string
          format: email
        phone:
          type: string
        dob:
          type: string
          format: date
          nullable: true
        gender:
          type: string
        marital_status:
          oneOf:
          - $ref: '#/components/schemas/MaritalStatusEnum'
          - $ref: '#/components/schemas/BlankEnum'
        id_number:
          type: string
        id_issued_date:
          type: string
          format: date
          nullable: true
        id_issued_place:
          type: string
        permanent_address:
          type: string
        address:
          type: string
        education_level:
          type: string
        major:
          type: string
        school:
          type: string
        tax_code:
          type: string
        social_insurance_no:
          type: string
        bank_account_no:
          type: string
        bank_name:
          type: string
        emergency_contact_name:
          type: string
        emergency_contact_relation:
          type: string
        emergency_contact_phone:
          type: string
        emergency_contact_address:
          type: string
        facebook_url:
          type: string
        vehicle_info:
          type: string
    PatchedFacebookAppPartialUpdate:
