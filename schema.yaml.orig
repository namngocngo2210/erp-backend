        urls:
          type: array
          items:
            type: string
      required:
      - urls
    BestShipment:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        account:
          type: integer
        account_name:
          type: string
          readOnly: true
        order:
          type: integer
          nullable: true
        merchant_order_code:
          type: string
          maxLength: 100
        code_best:
          type: string
          nullable: true
          maxLength: 100
        route_code:
          type: string
          maxLength: 100
        status:
          $ref: '#/components/schemas/BestShipmentStatusEnum'
        best_status_code:
          type: string
          maxLength: 32
        status_content:
          type: string
        cod:
          type: string
          format: decimal
          pattern: ^-?\d{0,12}(?:\.\d{0,2})?$
        product_price:
          type: string
          format: decimal
          pattern: ^-?\d{0,12}(?:\.\d{0,2})?$
        freight_fee:
          type: string
          format: decimal
          pattern: ^-?\d{0,12}(?:\.\d{0,2})?$
        cod_fee:
          type: string
          format: decimal
          pattern: ^-?\d{0,12}(?:\.\d{0,2})?$
        insurance_fee:
          type: string
          format: decimal
          pattern: ^-?\d{0,12}(?:\.\d{0,2})?$
        vat_fee:
          type: string
          format: decimal
          pattern: ^-?\d{0,12}(?:\.\d{0,2})?$
        return_fee:
          type: string
          format: decimal
          pattern: ^-?\d{0,12}(?:\.\d{0,2})?$
        discount:
          type: string
          format: decimal
          pattern: ^-?\d{0,12}(?:\.\d{0,2})?$
        total_fee:
          type: string
          format: decimal
          pattern: ^-?\d{0,12}(?:\.\d{0,2})?$
        weight:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          description: gram
        length:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          description: mm
        width:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          description: mm
        height:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          description: mm
        journey_type:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
        service_id:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
        pickup_type:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
        last_event_at:
          type: string
          format: date-time
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - account
      - account_name
      - created_at
      - id
      - merchant_order_code
      - updated_at
    BestShipmentListResponse:
      type: object
      properties:
        items:
          type: array
          items:
            $ref: '#/components/schemas/BestShipment'
        total:
          type: integer
      required:
      - items
      - total
    BestShipmentStatusEnum:
      enum:
      - created
      - picking_up
      - pickup_failed
      - picked_up
      - in_transit
      - out_for_delivery
      - delivery_failed
      - delivered
      - returning
      - return_failed
      - returned
      - lost
      - damaged
      - cancelled
      type: string
      description: |-
        * `created` - Đã tạo
        * `picking_up` - Đang đi lấy hàng
        * `pickup_failed` - Lấy hàng thất bại
        * `picked_up` - Đã lấy hàng
        * `in_transit` - Đang trung chuyển
        * `out_for_delivery` - Đang giao
        * `delivery_failed` - Giao thất bại
        * `delivered` - Giao thành công
        * `returning` - Đang chuyển hoàn
        * `return_failed` - Trả hàng thất bại
        * `returned` - Đã chuyển hoàn
        * `lost` - Thất lạc
        * `damaged` - Hư hỏng
        * `cancelled` - Đã hủy
    BlankEnum:
      enum:
      - ''
    BucketEnum:
      enum:
      - overdue
      - today
      - upcoming
      - ended
      - none
      type: string
      description: |-
        * `overdue` - overdue
        * `today` - today
        * `upcoming` - upcoming
        * `ended` - ended
        * `none` - none
