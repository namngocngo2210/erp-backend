    PatchedChannelTypeUpdate:
      type: object
      description: |-
        Sửa loại kênh — CỐ Ý không có ``code``.

        ``code`` là khoá nghiệp vụ: nó trùng giá trị ``SALE_CHANNEL_*`` mà báo cáo sẽ
        dựa vào, và hàm reverse của migration 0024 xoá seed theo đúng mã này. Đổi mã
        sau khi tạo là làm hỏng cả hai một cách âm thầm, nên chỉ cho sửa phần hiển thị.
      properties:
        name:
          type: string
          description: Tên hiển thị trên giao diện.
          maxLength: 100
        sort_order:
          type: integer
          maximum: 2147483647
          minimum: 0
          description: Thứ tự hiển thị trong dropdown; nhỏ hơn đứng trước.
        is_active:
          type: boolean
          description: Tắt để ẩn khỏi dropdown mà không xoá dữ liệu kênh đã gán.
    PatchedChannelUpdate:
      type: object
      properties:
        name:
          type: string
          maxLength: 255
        owner:
          type: string
          maxLength: 255
        landingpage_source:
          type: array
          items:
            type: string
            maxLength: 2048
        fb_ads_accounts:
          type: array
          items:
            type: integer
            minimum: 1
        google_ads_accounts:
          type: array
          items:
            type: integer
            minimum: 1
        kiotviet_mappings:
          type: array
          items:
            type: object
            additionalProperties: {}
        is_active:
          type: boolean
        department_ids:
          type: array
          items:
            type: integer
        channel_type_id:
          type: integer
          nullable: true
          description: Loại kênh bán (Shopee/TikTok/Facebook/Web); gửi null để bỏ
            phân loại.
        price_book_id:
          type: integer
          nullable: true
          description: Bảng giá gán cho kênh này; gửi null để gỡ gán (dùng bảng mặc
            định).
