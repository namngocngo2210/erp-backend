        role_ids:
          type: array
          items:
            type: integer
        department_ids:
          type: array
          items:
            type: integer
        permissions:
          type: array
          items:
            type: string
        scopes:
          type: object
          additionalProperties:
            type: string
        field_policy:
          type: object
          additionalProperties: {}
        is_superuser:
          type: boolean
      required:
      - allowed_sections
      - avatar_data_url
      - department
      - department_ids
      - display_name
      - editable_order_fields
      - field_policy
      - id
      - is_active
      - is_superuser
      - kiotviet_mappings
      - lark_open_id
      - permissions
      - role_ids
      - scopes
      - username
