components:
  schemas:
    ActionTypeEnum:
      enum:
      - CREATE
      - UPDATE
      - DELETE
      - READ
      - LOGIN
      - LOGOUT
      - API_REQUEST
      - KIOTVIET_REQUEST
      - SYSTEM
      type: string
      description: |-
        * `CREATE` - Create
        * `UPDATE` - Update
        * `DELETE` - Delete
        * `READ` - Read
        * `LOGIN` - Login
        * `LOGOUT` - Logout
        * `API_REQUEST` - API Request
        * `KIOTVIET_REQUEST` - KiotViet Request
        * `SYSTEM` - System
    AdjustReturnEntry:
      type: object
      description: Điều chỉnh số lượng dòng của nhóm đơn ĐÃ GHI SỔ (Lịch sử nhập xuất).
      properties:
        lines:
          type: array
          items:
            $ref: '#/components/schemas/_AdjustLineInput'
      required:
      - lines
    AdminUserCreate:
      type: object
      properties:
        username:
          type: string
          maxLength: 150
        display_name:
          type: string
          default: ''
          maxLength: 150
        is_active:
          type: boolean
          default: true
        kiotviet_mappings:
          type: array
          items:
            type: object
            additionalProperties: {}
        password:
          type: string
          minLength: 8
        department_id:
          type: integer
          nullable: true
        lark_open_id:
          type: string
          default: ''
          maxLength: 128
        zenify_email:
          type: string
          format: email
          default: ''
        foxia_id:
          type: string
          default: ''
          maxLength: 64
        media_role:
          default: ''
          oneOf:
          - $ref: '#/components/schemas/MediaRoleEnum'
          - $ref: '#/components/schemas/BlankEnum'
        media_api_key:
          type: string
          nullable: true
          default: ''
          maxLength: 1024
        role_ids:
          type: array
          items:
            type: integer
            minimum: 1
        department_ids:
          type: array
          items:
            type: integer
            minimum: 1
      required:
      - password
      - username
    AdminUserListResponse:
      type: object
      description: Response GET /api/users/admin (phân trang) — chỉ dùng khai OpenAPI.
      properties:
        items:
          type: array
          items:
            $ref: '#/components/schemas/User'
        total:
          type: integer
      required:
      - items
      - total
    AdsReportProductBreakdownResponse:
      type: object
      properties:
        rows: {}
      required:
      - rows
    AdsReportSummaryResponse:
      type: object
      properties:
        revenue_by_channel: {}
        top_products: {}
        daily_breakdown: {}
        assigned_ads_cost:
          type: string
        revenue_by_province: {}
        revenue_by_gender: {}
      required:
      - assigned_ads_cost
      - daily_breakdown
      - revenue_by_channel
      - revenue_by_gender
      - revenue_by_province
      - top_products
    ApplyResultRequest:
      type: object
      properties:
        result_id:
          type: integer
        scheduled_at:
          type: string
          format: date-time
          nullable: true
      required:
      - result_id
    AssignBatch:
      type: object
      properties:
        product_id:
          type: integer
      required:
      - product_id
    Attendance:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        work_date:
          type: string
          format: date
        check_in:
          type: string
          format: time
          nullable: true
        check_out:
          type: string
          format: time
          nullable: true
        note:
          type: string
          maxLength: 255
        source:
          $ref: '#/components/schemas/AttendanceSourceEnum'
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - work_date
    AttendanceSet:
      type: object
      properties:
        work_date:
          type: string
          format: date
        check_in:
          type: string
          format: time
          nullable: true
        check_out:
          type: string
          format: time
          nullable: true
        note:
          type: string
          default: ''
      required:
      - work_date
    AttendanceSourceEnum:
      enum:
      - manual
      - self
      - lark
      type: string
      description: |-
        * `manual` - Nhập tay
        * `self` - Tự chấm công (ESS)
        * `lark` - Đồng bộ Lark
    AuditLogList:
      type: object
      description: Serializer nhẹ cho danh sách - chỉ trả về curl_command
      properties:
        id:
          type: integer
          readOnly: true
        user:
          type: string
          readOnly: true
        action_type:
          $ref: '#/components/schemas/ActionTypeEnum'
        entity_type:
          $ref: '#/components/schemas/EntityTypeEnum'
        entity_id:
          type: string
          nullable: true
          maxLength: 100
        method:
          type: string
          nullable: true
          maxLength: 10
        timestamp:
          type: string
          format: date-time
          readOnly: true
        duration_ms:
          type: integer
          maximum: 2147483647
          minimum: 0
          nullable: true
        source:
          $ref: '#/components/schemas/AuditLogListSourceEnum'
        curl_command:
          type: string
          nullable: true
          readOnly: true
      required:
      - action_type
      - curl_command
      - entity_type
      - id
      - timestamp
      - user
    AuditLogListResponse:
      type: object
      description: 'Schema-only: mô tả envelope phân trang của GET /api/audit-logs/.'
      properties:
        items:
          type: array
          items:
            $ref: '#/components/schemas/AuditLogList'
        total:
          type: integer
        limit:
          type: integer
        offset:
          type: integer
      required:
      - items
      - limit
      - offset
      - total
    AuditLogListSourceEnum:
      enum:
      - user_action
      - api_request
      - kiotviet
      type: string
      description: |-
        * `user_action` - User Action
        * `api_request` - API Request
        * `kiotviet` - KiotViet
    AwaitingReturnCloseError:
      type: object
      properties:
        detail:
          type: string
      required:
      - detail
    AwaitingReturnCloseRequest:
      type: object
      properties:
        reason:
          type: string
        note:
          type: string
      required:
      - reason
    AwaitingReturnCloseResponse:
      type: object
      properties:
        status:
          type: string
      required:
      - status
    AwaitingReturnItem:
      type: object
      properties:
        order_id:
          type: integer
        order_code:
          type: string
        invoice_code:
          type: string
        shipping_code:
          type: string
        customer_name:
          type: string
        warehouse_id:
          type: integer
        warehouse_name:
          type: string
        cancelled_at:
          type: string
          format: date-time
        days_waiting:
          type: integer
        status:
          type: string
        closed_reason:
          type: string
        closed_note:
          type: string
        note:
          type: string
        lines:
          type: array
          items:
            $ref: '#/components/schemas/AwaitingReturnLine'
      required:
      - cancelled_at
      - closed_note
      - closed_reason
      - customer_name
      - days_waiting
      - invoice_code
      - lines
      - note
      - order_code
      - order_id
      - shipping_code
      - status
      - warehouse_id
      - warehouse_name
    AwaitingReturnLine:
      type: object
      properties:
        product_id:
          type: integer
        sku:
          type: string
        qty:
          type: integer
      required:
      - product_id
      - qty
      - sku
    AwaitingReturnPage:
      type: object
      properties:
        count:
          type: integer
        results:
          type: array
          items:
            $ref: '#/components/schemas/AwaitingReturnItem'
      required:
      - count
      - results
    BestAccount:
      type: object
      description: Thông tin account an toàn để hiển thị — KHÔNG bao giờ trả password/token.
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          title: Tên tài khoản
          maxLength: 255
        environment:
          allOf:
          - $ref: '#/components/schemas/EnvironmentEnum'
          default: test
        username:
          type: string
          maxLength: 255
        is_active:
          type: boolean
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - name
      - username
    BestPrintWaybillResponse:
      type: object
