      - display_name
      - is_active
      - is_primary
      - user_id
      - username
    EmployeeChild:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 150
        birth_year:
          type: integer
          maximum: 2147483647
          minimum: 0
          nullable: true
      required:
      - id
    EmployeeCreate:
      type: object
      properties:
        full_name:
          type: string
          maxLength: 150
        department_id:
          type: integer
