          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedFlowPendingNoteUpdate'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedFlowPendingNoteUpdate'
      security:
      - BearerAuth: []
      - BearerAuth: []
      responses:
        '200':
