#!/usr/bin/env bash
# Pre-push: hàng rào kiến trúc backend (lint-imports + ruff) — audit 2026-09-23 N1.
#
# Bật một lần cho mỗi clone:  git config core.hooksPath .githooks
# (README, mục "Git hooks"). Không có docker lẫn lint-imports/ruff thì script tự
# thoát 0 — dev chỉ làm frontend không bị chặn. Đây là GỜ GIẢM TỐC, cổng thật là CI.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
exec sh "$REPO_ROOT/scripts/check-backend-arch.sh"
