    apps.inventory.transport.views.flow_pending_views -> apps.orders.crm_catalog
    apps.inventory.transport.views.flow_pending_views -> apps.orders.models
    apps.inventory.transport.views.flow_pending_views -> apps.orders.repositories
    # inventory -> warranty (1)
    apps.inventory.application.services.pending_scan_service -> apps.warranty.journey_service
    # orders -> callcenter (1)
