    apps.orders.application.services.contact_activity_service -> apps.customers.models
    apps.orders.application.services.contact_list_service -> apps.customers.models
    apps.orders.application.services.lead_filter_service -> apps.customers.services
    apps.orders.application.services.order_service_shared -> apps.customers.models
    apps.orders.application.services.order_service_shared -> apps.customers.services
    apps.orders.kiotviet_validation -> apps.customers.services
    apps.orders.management.commands.import_assessment_csv -> apps.customers.models
    apps.orders.management.commands.import_assessment_csv -> apps.customers.services
    apps.orders.models -> apps.customers.models
    apps.orders.transport.views.order_views_impl.contact_scope -> apps.customers.models
    apps.orders.transport.views.order_views_impl.order_action_view -> apps.customers.customer_type
    # orders -> inventory (6)
    apps.orders.application.services.order_service_commands -> apps.inventory.application.services.stock_sales_service
    apps.orders.infrastructure.tasks.order_tasks_impl.lark_notification_tasks -> apps.inventory.application.services.reissue_sibling
    apps.orders.application.services.order_service_commands -> apps.inventory.contracts.stock_sales
    apps.orders.transport.views.shipping_lookup_view -> apps.inventory.application.services.pending_scan_service
    apps.orders.transport.views.shipping_lookup_view -> apps.inventory.application.services.stock_sales_service
    apps.orders.transport.views.shipping_lookup_view -> apps.inventory.models
    # users -> channels_core (4)
    apps.users.rbac -> apps.channels_core.models
    apps.users.scoping -> apps.channels_core.models
    apps.users.services -> apps.channels_core.cache_utils
    apps.users.services -> apps.channels_core.models


# Audit 2026-09-23 (T3/P2-2): tầng domain phải PURE — không django / DRF / celery.
# Giá trị settings/timezone đi qua tham số từ application/transport (xem
# hr/domain/workday.py, warranty_codes/domain/serial.py, daily_report/domain/periods.py,
# best_express/domain/status_map.py). Wildcard `apps.*.domain` bắt luôn app mới.
# Chỉ bắt import TRỰC TIẾP (allow_indirect_imports): domain còn 3 chỗ import
# `<app>.models` (foxia.domain.catalog_specs, hr.domain.leave,
# orders.domain.contact_rules) — đó là nợ domain → ORM, xử lý riêng, không che
# bằng cách nới contract này.
[importlinter:contract:domain-pure]
name = Domain không import framework
type = forbidden
source_modules =
    apps.*.domain
forbidden_modules =
    django
    rest_framework
    celery
allow_indirect_imports = True
