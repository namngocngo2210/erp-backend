DJANGO_SECRET_KEY=change-me
JWT_SIGNING_KEY=change-me-with-at-least-32-bytes-for-hs256
# Vòng đời token. Access token là JWT tự chứa nên KHÔNG thu hồi được trước hạn
# (blacklist chỉ áp cho refresh token) — giữ ngắn. FE tự refresh trước khi hết hạn
# nên giá trị nhỏ không làm user bị đăng xuất.
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14
DJANGO_DEBUG=1
# Bật profile monitoring thì PHẢI có "web": Prometheus scrape
# http://web:8000/api/orders/metrics qua container DNS, thiếu thì Django trả 400
# DisallowedHost và job desi-backend down (không thu được metric ứng dụng).
# Prod bật portal tra cứu bảo hành (tra-cuu.delax.asia) thì thêm domain vào cả
# hai biến dưới: DJANGO_ALLOWED_HOSTS,tra-cuu.delax.asia và
# DJANGO_CSRF_TRUSTED_ORIGINS,https://tra-cuu.delax.asia.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,32ad-42-114-36-163.ngrok-free.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://32ad-42-114-36-163.ngrok-free.app
POSTGRES_DB=desi_order
POSTGRES_USER=desi_order
POSTGRES_PASSWORD=desi_order
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis
REDIS_CACHE_DB=1
REDIS_CHANNEL_DB=2
REDIS_CELERY_BROKER_DB=3
REDIS_CELERY_RESULT_DB=4
# ── Cache trên instance Redis RIÊNG (audit 2026-08-11 §2.1) ───────────────────
# Prod/staging đặt REDIS_CACHE_HOST=redis-cache + REDIS_CACHE_DB=0 ngay trong
# compose, KHÔNG cần khai ở .env. Chỉ đặt ở đây khi muốn trỏ cache đi chỗ khác.
# Bỏ trống = dùng chung instance với broker/channels (hành vi trước 2026-08-11,
# cũng là đường rollback).
# REDIS_CACHE_HOST=redis-cache
# REDIS_CACHE_PORT=6379
# REDIS_CACHE_PASSWORD=change-me-redis
# Trần bộ nhớ instance cache; đầy thì evict theo LRU (không bao giờ chặn ghi).
# Chỉnh khi `evicted_keys` tăng liên tục mà hit rate tụt — xem runbook §4.
REDIS_CACHE_MAXMEMORY=256mb
# Timeout socket tới Redis cache (giây). Có timeout thì Redis TREO mới biến thành
# lỗi bắt được, và fail-soft của apps.common.cache_backend mới có tác dụng.
# REDIS_CACHE_SOCKET_TIMEOUT=0.5
# REDIS_CACHE_CONNECT_TIMEOUT=0.5
# Nén JSON: "1" = Django nén (mặc định, hành vi cũ), "0" = giao cho nginx.
# Chỉ đặt "0" SAU khi xác nhận nginx host có `gzip_proxied any` — runbook §8.
WEB_GZIP_IN_DJANGO=1
# Async task backend: celery (default) | go (emergency rollback to Go services)
TASK_BACKEND=celery
AUDIT_BACKEND=celery
# Batch audit: web gom entry, đầy SIZE thì enqueue 1 task audit.create_batch;
# batch lửng flush sau MAX_DELAY giây. SIZE=1 = hành vi cũ (1 task/request).
AUDIT_BATCH_SIZE=20
AUDIT_BATCH_MAX_DELAY_SECONDS=2
CELERY_WORKER_CONCURRENCY=4
# Recycle child sau N task để chống memory leak tích tụ (tương đương gunicorn --max-requests).
CELERY_WORKER_MAX_TASKS_PER_CHILD=300
# Lưới an toàn theo RSS (KB). 0=tắt — KHÔNG tắt ở prod: child bị cgroup OOM killer
# SIGKILL sẽ bỏ lại connection Postgres mồ côi và cạn max_connections (sự cố 2026-07-21).
# Đặt ~ (mem_limit_MB - RAM_parent) *1024/concurrency*0.85. Prod 1GiB/concurrency=4 → 180000 (≈175MB).
CELERY_WORKER_MAX_MEMORY_PER_CHILD=180000
CELERY_TIMEZONE=Asia/Bangkok
KIOTVIET_DEBUG_CREATE_ORDER_PAYLOAD=0
KIOTVIET_API_MODE=mock
DJANGO_SQL_LOG_ENABLE=0
DJANGO_SQL_LOG_LEVEL=DEBUG

# ===== Đã chuyển vào DB (2026-09-19) =====
# Credential đối tác (Lark, Gemini, Zenify, CNV, token API vào…) và tham số vận hành
# (cờ bật/tắt, ngưỡng QA, thông tin công ty portal…) KHÔNG còn đọc từ .env — sửa ở
# Cài đặt → Cấu hình hệ thống (superuser). Danh sách khóa: backend/apps/sysconfig/registry.py.
# Boot sẽ CHẾT nếu .env còn khóa nào trong danh sách đó. Xem docs/system-settings.md.
# SYSCONFIG_ALLOW_ENV_KEYS=1   # chỉ trong cửa sổ deploy chuyển đổi

# ===== Gemini (Zenify call transcribe/extract) — phần chưa chuyển vào DB =====
# API key, model transcribe/extract, RPM/RPD, cờ GEMINI_EXTRACT_ENABLED/AI_CHAT_EXTRACT_ENABLED
# → Cấu hình hệ thống (nhóm "Gemini / AI").
GEMINI_MAX_ATTEMPTS=3
# Số record 1 tick cron xử lý (tuần tự, 15-20s/record — đừng vượt soft_time_limit 480s).
GEMINI_TRANSCRIBE_BATCH=20
GEMINI_QUOTA_COOLDOWN_MINUTES=60
GEMINI_EXTRACT_BATCH=20
GEMINI_EXTRACT_MAX_ATTEMPTS=3
GEMINI_EXTRACT_MIN_TRANSCRIPT_CHARS=200
# Chấm chất lượng cuộc gọi sale từ transcript (trang Báo cáo → Chất lượng cuộc gọi).
# Cờ bật, model, ngưỡng thời lượng/transcript/điểm đạt → Cấu hình hệ thống (nhóm
# "Chấm chất lượng cuộc gọi").
QA_SCORING_BATCH=20                     # cỡ mỗi lô; task chấm cuốn chiếu nhiều lô tới khi hết
QA_SCORING_MAX_MINUTES=60               # trần thời gian một lượt cuốn chiếu (0 = không giới hạn)
QA_SCORING_MAX_ATTEMPTS=3

# Optional override:
# REDIS_CACHE_URL=redis://redis:6379/1
# REDIS_CHANNEL_URL=redis://redis:6379/2

# ===== Required for docker-compose.full.yml =====
# Sinh bằng: python -c 'from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())'
ENCRYPTION_KEY=
# Token ingest/Hermes/Daily Report, mọi LARK_* (webhook/secret/Bitable/checkin) → Cấu hình
# hệ thống (nhóm "Token API vào" / "Lark bot" / "Lark OpenAPI"). Rate throttle của Hermes/
# Daily Report KHÔNG chuyển (DRF đọc lúc boot, không đọc lại lúc chạy).
HERMES_THROTTLE_RATE=600/hour
DAILY_REPORT_THROTTLE_RATE=300/hour
# Bot Lark nhận alert Prometheus (profile monitoring). Đọc bởi service
# lark-alert-adapter, KHÔNG phải Django — không thuộc registry sysconfig, giữ ở .env.
# payload Alertmanager không đúng định dạng Lark nên phải qua monitoring/lark_alert_adapter.py.
# Trống = chỉ in log.
LARK_ALERT_WEBHOOK_URL=
CORS_ALLOWED_ORIGINS=http://localhost
HTTP_PORT=80
WEB_WORKERS=3
# 0 = TẮT recycle worker theo số request. Với UvicornWorker phục vụ WebSocket, mỗi lần
# recycle cắt đứt mọi WS client trên worker đó → toàn bộ client reconnect cùng lúc và
# cạn max_connections (sự cố 2026-07-23). Chỉ bật lại nếu thật sự có rò rỉ RAM ở web.
WEB_MAX_REQUESTS=0
# Trần truy vấn DB đồng thời cho bắt tay WebSocket, tính trên MỖI gunicorn worker.
# Trần thực tế của web = giá trị này × WEB_WORKERS — giữ tổng dưới max_connections.
WS_HANDSHAKE_DB_CONCURRENCY=8
# Trần cho truy vấn DB FALLBACK lúc phân quyền event broadcast (sự cố 2026-07-29:
# consumer tra DB cho mỗi event × mỗi client → số connection tỉ lệ số tab đang mở).
# Đường chính không chạm DB vì payload tự mang staff_id/channel_code; trần này chỉ
# để một call site còn sót field không kéo sập cả trần connection. Thấy log
# "broadcast payload thiếu ..." ở desi-web nghĩa là còn call site cần vá.
WS_BROADCAST_DB_CONCURRENCY=4
# Tuổi connection Django. ĐỂ TRỐNG là an toàn: settings tự suy 0 khi không có
# pooler và 600 khi DB_PGBOUNCER=1. Chỉ đặt tay khi thật sự cần override.
# DJANGO_CONN_MAX_AGE=

# ===== PgBouncer cutover (runbook docs/runbooks/2026-07-24-pgbouncer-cutover.md) =====
# Bật đủ BỘ BA biến sau cùng lúc rồi recreate web/worker. Thiếu DB_PGBOUNCER=1 mà
# vẫn trỏ host sang pgbouncer = lỗi "prepared statement does not exist" NGẪU NHIÊN
# dưới tải. Migration không cần quan tâm — compose đã ghim migrate nối thẳng Postgres.
#
# ⚠️ ĐỔI DB_TARGET_HOST/PORT, KHÔNG đổi POSTGRES_HOST/POSTGRES_PORT ở trên.
# POSTGRES_HOST phía trên là góc nhìn của HOST (psql, script backup) — compose
# KHÔNG đọc nó cho container nữa. Sự cố 2026-07-30 23:33: lúc passthrough thẳng
# ${POSTGRES_HOST}, giá trị localhost của host rò vào container → web boot fail
# "connection to server at 127.0.0.1:5432 refused". Để trống = container nối
# service `postgres:5432` như thường.
# DB_PGBOUNCER=1
# DB_TARGET_HOST=pgbouncer
# DB_TARGET_PORT=6432

# ===== Best Express (đấu nối trực tiếp Best V3) =====
# Không còn khóa nào ở .env. Tài khoản (environment/username/password/EMS key) quản
# lý trên bảng BestExpressAccount (Django admin); webhook token nằm ở
# BestExpressAccount.webhook_token. Xem docs/system-settings.md.

# ===== CNV Loyalty (SSO OAuth id.cnv.vn + REST apis.cnvloyalty.com) =====
# client_id/client_secret: tạo bằng CnvConnection (Django admin), không còn ở .env.
# Cờ bật sync + account name/id + redirect/SSO/API URL → Cấu hình hệ thống (nhóm
# "Foxia / Pancake / CNV"). Sau khi cấu hình xong, admin nối SSO qua GET /api/cnv/connect.
# ----- Chiều NGƯỢC: kéo đơn từ CNV về (spec 2026-08-19) -----
# Bật SAU KHI đã `manage.py cnv_webhook register` thành công.
CNV_INBOUND_ENABLED=0
# Token mình tự sinh (chuỗi ngẫu nhiên dài), khai với CNV lúc register rồi CNV
# gửi lại ở header. Rỗng = endpoint webhook từ chối MỌI request.
CNV_WEBHOOK_VERIFY_TOKEN=
# URL public CNV gọi vào: https://<domain>/api/cnv/webhook
CNV_WEBHOOK_CALLBACK_URL=
# Swagger CNV không liệt kê topic hợp lệ — chạy `manage.py cnv_webhook list` để
# biết tên thật rồi sửa dòng này, không phải sửa code.
CNV_WEBHOOK_TOPICS=orders/create,orders/updated
# CNV_INBOUND_LOOKBACK_MINUTES=120
# CNV_WEBHOOK_EVENT_RETENTION_DAYS=30

# MinIO (ảnh chấm công). Backend tự dùng ROOT_USER/PASSWORD làm S3 access/secret key
# (compose map MINIO_ACCESS_KEY=MINIO_ROOT_USER, MINIO_SECRET_KEY=MINIO_ROOT_PASSWORD)
# → chỉ cần đặt 2 biến này (mật khẩu tối thiểu 8 ký tự).
MINIO_ROOT_USER=desi-minio
MINIO_ROOT_PASSWORD=change-me-strong-min-8-chars
MINIO_BUCKET_ATTENDANCE=attendance
# (tuỳ chọn) đổi IP bind console 9001, mặc định 127.0.0.1
# MINIO_CONSOLE_BIND_IP=127.0.0.1

# ===== Monitoring =====
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
PROM_RETENTION=30d
# Port host bind của Prometheus (chỉ 127.0.0.1, dùng để debug + POST /-/reload).
# Đổi khi 9090 đã bị service khác trên host chiếm.
# PROM_HOST_PORT=9092
# Publish Grafana qua nginx host theo sub-path (nginx/grafana-subpath.location.example).
# Bỏ trống = chỉ vào được bằng SSH tunnel tới 127.0.0.1:3001.
# GRAFANA_ROOT_URL=https://erp.desiglobal.vn/grafana/
# GRAFANA_SERVE_FROM_SUB_PATH=true
# Heartbeat giám sát ngoài (healthchecks.io) — beat ping mỗi 5', trống = tắt.
# CHỈ đặt ở prod; staging bị settings guard chặn (docs/ops-hardening-2026-07.md).
# OPS_HEARTBEAT_URL=https://hc-ping.com/<uuid>
# Loki log retention (mặc định 14d, đổi trong monitoring/loki-config.yml)
# LOG_FORMAT=json bật JSON log kèm request_id — NÊN bật khi chạy Loki
# LOG_FORMAT=json
# Token bảo vệ /api/orders/metrics ở TẦNG APP (lớp hai). Lớp một là nginx chặn theo
# dải IP nội bộ — nhưng repo có 2 file nginx và trước 2026-07-26 chỉ file của host mới
# chặn, nên môi trường dùng file kia phơi metrics ra internet (audit C3). Trống = tắt,
# giữ nguyên hành vi cũ. Bật thì scraper phải gửi header X-Metrics-Token.
# METRICS_ALLOW_TOKEN=

# ===== Giới hạn tần suất (throttle) =====
# Thiết kế đầy đủ 4 lớp (nginx / DRF / outbound / metric):
#   docs/rate-limiting-hardening-2026-07.md
# Mọi biến dưới đây đổi được bằng env, KHÔNG cần deploy code. Đặt RỖNG để tắt hẳn
# trần tương ứng.
#
# Trần MẶC ĐỊNH cho mọi endpoint DRF không tự khai throttle riêng.
# Theo user: van chống chạy loạn (tab kẹt vòng lặp / script), không phải hạn ngạch.
# USER_THROTTLE_RATE=3000/hour
# Theo IP client thật. CẨN THẬN: cả văn phòng ra internet chung MỘT IP NAT nên
# trần này phải đủ rộng cho toàn công ty. Endpoint máy-tới-máy (metrics, ingest,
# webhook, refresh token) đã được miễn trừ sẵn trong apps/common/throttling.py.
# ANON_THROTTLE_RATE=600/hour
# Miễn trừ THÊM view khỏi trần mặc định (theo `name=` trong urls.py, phân tách bằng
# dấu phẩy). Danh sách mặc định luôn được giữ — biến này chỉ CỘNG THÊM.
# THROTTLE_EXEMPT_VIEWS=
#
# Chống brute-force đăng nhập, theo IP. Giá trị mặc định giữ nguyên như trước.
# LOGIN_THROTTLE_RATE=10/min
#
# Trần in hóa đơn / phiếu giao, tính THEO USER (không theo IP: nhân viên kho ngồi
# chung một NAT). Mỗi request in có thể tạo tới 200 lượt gọi HTTP tuần tự sang KiotViet
# nên đây vừa là chặn lạm dụng vừa là van bảo vệ rate-limit của KiotViet.
# Giá trị hiện tại là điểm khởi đầu rộng — đo tỉ lệ 429 thực tế rồi siết dần.
# ORDER_PRINT_THROTTLE_RATE=120/min
#
# ===== Trần gọi RA KiotViet (key theo retailer, dùng chung qua Redis) =====
# Khác KIOTVIET_TASK_RATE_LIMIT (nhịp task Celery — mỗi task lại bắn hàng trăm
# request): đây là trần trên TỪNG lệnh gọi HTTP, áp cho mọi worker cộng lại.
# KIOTVIET_RATE_LIMIT_PER_SECOND=10
# Chờ tối đa bao lâu rồi vẫn gọi (fail-open). Chạm ngưỡng này sẽ bắn alert
# OutboundRateLimitSaturated.
# KIOTVIET_RATE_LIMIT_MAX_WAIT=10

# ===== Cảnh báo vận hành (ops alerts) =====
# Webhook Lark custom bot nhận cảnh báo sự cố tích hợp (token Facebook hỏng/sắp hết
# hạn, báo cáo ads bị chặn) → Cấu hình hệ thống (nhóm "Lark bot", LARK_OPS_ALERT_*).
# Trống = không gửi webhook, cảnh báo vẫn vào logger.error để Sentry/Grafana bắt.
# Xem docs/facebook-token-lifecycle-2026-07-27.md.

# ===== Facebook Ads =====
# Cảnh báo trước bao nhiêu ngày khi token sắp hết hạn (FB_TOKEN_EXPIRY_WARN_DAYS)
# → Cấu hình hệ thống (nhóm "Đơn hàng / Portal"). System User token (Business
# Manager, bỏ tick expiration) không hết hạn nên không bao giờ chạm ngưỡng này —
# đó là dạng token DUY NHẤT nên dùng cho đồng bộ tự động.
# Nhịp cron kéo chi tiêu Facebook (giây). Hạ từ 60s xuống 300s ngày 27/07/2026: FB
# không cập nhật insights theo phút, tick dày chỉ đốt rate limit.
# FB_SYNC_INTERVAL_SECONDS=300

# ===== Celery — queue cho task chạy dài =====
# Nhóm task LLM/transcription (callcenter) + precompute báo cáo (customers) được tách
# khỏi queue `default` để không chiếm hết slot của các sweep điều phối lead — thứ người
# dùng cảm nhận ngay (audit 2026-07-26 T5). Xem docs/runbooks/2026-07-26-add-slow-worker.md.
# CELERY_SLOW_QUEUE=slow
# Số slot của desi-worker-slow.
# SLOW_WORKER_CONCURRENCY=2
# Ngưỡng RSS (KB) recycle child. ĐỔI concurrency thì PHẢI tính lại:
# (mem_limit − 180MB parent) / concurrency × 0.85.
# SLOW_WORKER_MAX_MEMORY_PER_CHILD=358000

# ===== Xuất file chạy nền (apps.exports, spec 2026-08-06) =====
# Compose không có service nào khai `env_file` — mọi ${...} trong compose nội suy
# từ file .env này (KHÔNG phải backend/.env.example, file đó không được compose
# đọc). Bám khuôn khối `slow` ở trên: worker riêng, queue riêng.
# Tên queue Celery dành riêng cho job export.
# CELERY_EXPORTS_QUEUE=exports
# Số slot của desi-worker-export.
# EXPORT_WORKER_CONCURRENCY=2
# Ngưỡng RSS (KB) recycle child. worker-export có mem_limit 768m (prod) — công
# thức giống worker-slow: (768 − 180 parent) / concurrency 2 × 0.85 ≈ 250000.
# ĐỔI concurrency thì PHẢI tính lại, nếu không cgroup OOM killer SIGKILL child
# trước khi Celery kịp recycle → connection Postgres mồ côi.
# EXPORT_WORKER_MAX_MEMORY_PER_CHILD=250000
# Bucket MinIO chứa file export (tự tạo ở lần upload đầu tiên).
# MINIO_BUCKET_EXPORTS=desi-exports
# TTL file export trên MinIO (giờ) — quá hạn bị purge_expired_exports dọn.
# EXPORT_FILE_TTL_HOURS=24
# Trần thời gian một job export được chạy (giây) — override CELERY_TASK_SOFT_TIME_LIMIT
# toàn cục (25s, không đủ cho file 50.000 dòng). time_limit hard = giá trị này + 60s.
# EXPORT_SOFT_TIME_LIMIT=600
# Trần số job pending/running đồng thời của MỘT user — chặn spam bấm Xuất.
# EXPORT_MAX_ACTIVE_JOBS_PER_USER=5
# Trần tạo job export theo giờ, MỖI user (DRF throttle scope).
# EXPORT_CREATE_THROTTLE_RATE=30/hour

# ===== Sentry — upload sourcemap frontend =====
# 4 biến dưới CHỈ dùng lúc build frontend (vite), không phải runtime. Thiếu token
# thì build vẫn chạy bình thường, chỉ là Sentry không giải mã được stack trace.
# Token Sentry (scope project:releases). Khai ở GitLab Settings → CI/CD → Variables
# dạng masked+protected — TUYỆT ĐỐI không commit giá trị thật vào repo.
SENTRY_AUTH_TOKEN=
# Slug organization trên Sentry (lấy trong URL: sentry.io/organizations/<org>/)
SENTRY_ORG=
# Slug project trên Sentry nhận sourcemap của frontend
SENTRY_PROJECT=
# Định danh bản build, phải KHỚP giữa lúc upload map và lúc Sentry.init chạy ở
# browser. CI tự đặt = $CI_COMMIT_SHA (xem .gitlab-ci.yml job frontend:build).
VITE_SENTRY_RELEASE=

# ===== Portal tra cứu bảo hành (tra-cuu.delax.asia) =====
# Khách nhập SĐT + mã bảo hành, không đăng nhập. Xem docs/warranty-portal-design.md.
# Thời hạn bảo hành (tháng) + giữ log quét (ngày) + token Zalo OA → Cấu hình hệ thống
# (nhóm "Đơn hàng / Portal" / "Token API vào"). Các trần throttle dưới KHÔNG chuyển
# (DRF đọc lúc boot, không đọc lại lúc chạy).
WARRANTY_PORTAL_ACTIVATE_RATE=10/hour
WARRANTY_PORTAL_READ_RATE=120/hour
WARRANTY_PORTAL_MEDIA_RATE=600/hour

# ===== Trang sản phẩm public /sp/<mã> (docs/product-scan-page-design.md) =====
# URL in lên tem QR (WARRANTY_QR_BASE_URL) + thông tin doanh nghiệp footer
# (PORTAL_COMPANY_*) → Cấu hình hệ thống (nhóm "Đơn hàng / Portal"). Sai giá trị
# URL tem hỏng cả lô tem đã in — cẩn thận khi đổi.
MINIO_BUCKET_PRODUCTS=product-media

# ===== DWH analytics (schema `dwh`, apps.analytics) =====
# Trần thời gian (giây) cho mỗi câu REFRESH MATERIALIZED VIEW lúc chạy task
# apps.analytics.tasks.refresh_dwh_marts (lịch 04:25 hằng đêm). Task refresh 3 mart
# TUẦN TỰ trong 1 task có time_limit=1800 — 3 × giá trị này phải nằm dưới 1800, nếu
# không worker bị hard-kill giữa chừng mà không raise lỗi matview nào.
DWH_REFRESH_TIMEOUT_SECONDS=480
# Trần tuổi (giờ) của mốc refresh mà dwh_reconcile chấp nhận. Job refresh chạy
# mỗi đêm 04:25 — 36h chấp nhận bỏ lỡ 1 đêm, từ chối chạy nếu bỏ lỡ 2 đêm liên
# tiếp (kho dữ liệu coi như đã chết).
DWH_RECONCILE_MAX_BOUNDARY_AGE_HOURS=36

# ===== Go services =====
# 32+ byte token, Django ↔ Go services chia sẻ
INTERNAL_AUTH_TOKEN=change-me-internal-token-32-bytes-min
# URL audit-writer (Django gọi để buffer event)
AUDIT_WRITER_BASE_URL=http://audit-writer:8080
# URL Django nội bộ (Go task-worker gọi cho Pattern B + KV access-token)
DJANGO_INTERNAL_BASE=http://web:8000/api/internal
# DATABASE_URL + REDIS_URL cho Go services (compose tự build từ POSTGRES_*/REDIS_*)
# Có thể override nếu chạy ngoài compose:
# DATABASE_URL=postgres://desi:desi@postgres:5432/desi?sslmode=disable
# REDIS_URL=redis://:change-me-redis@redis:6379/2

# ===== Foxia =====
# Đẩy đơn landing sang Foxia (spec 2026-09-09), poll hội thoại Pancake: cờ bật +
# base URL + timeout → Cấu hình hệ thống (nhóm "Foxia / Pancake / CNV"). Bật SAU khi
# bảng liên kết đã điền id / đã nhập token + gán page.
CELERY_FOXIA_PUSH_QUEUE=foxia_push
# Mặc định 1, KHÔNG PHẢI 2 (ruling controller, review 2026-09-09 mục I6): host
# chỉ còn ~2.2GB khả dụng + 2.5GB swap đã dùng trên 31 container. Trước đây
# backfill `foxia` CHIA hai slot với job của worker-slow, chưa từng SỞ HỮU
# nguyên hai slot riêng, và `foxia_push` chỉ là một request HTTP ngắn — không
# có lý do giữ 2. Staging đã là concurrency 1 sẵn.
FOXIA_WORKER_CONCURRENCY=1
# worker-foxia kế thừa queue `foxia` (backfill 900s) từ worker-slow, lịch sử ở
# concurrency 2, nên giữ NGUYÊN ngưỡng recycle RSS tính theo concurrency đó dù
# mặc định FOXIA_WORKER_CONCURRENCY đã hạ còn 1 (an toàn hơn, không sai — xem
# comment docker-compose.prod.yml service worker-foxia): (mem_limit 1024MB -
# parent ~180MB) / concurrency 2 * 0.85 ≈ 358000KB. Đổi FOXIA_WORKER_CONCURRENCY
# LÊN (vượt 2) thì PHẢI đổi giá trị này theo.
FOXIA_WORKER_MAX_MEMORY_PER_CHILD=358000
