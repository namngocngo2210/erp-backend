# Env template cho STAGING (docker-compose.staging.yml).
# cp .env.staging.example .env.staging rồi điền — TOÀN BỘ secrets sinh MỚI,
# KHÔNG copy từ .env prod. Xem docs/staging-environment.md.
#
# Dùng: docker compose -f docker-compose.staging.yml --env-file .env.staging up -d --build

# ── Django ──
# Sinh: python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
JWT_SIGNING_KEY=
DJANGO_ALLOWED_HOSTS=staging.customer.delax.vn,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.customer.delax.vn
CORS_ALLOWED_ORIGINS=https://staging.customer.delax.vn

# ── Postgres / Redis (chỉ nội bộ stack staging) ──
POSTGRES_DB=desi
POSTGRES_USER=desi
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ── Encryption ──
# ⚠️ BẮT BUỘC KHÁC PROD. Token bên thứ ba restore từ dump prod sẽ decrypt fail
# → thành rác vô hại (staging_neutralize còn xóa tường minh, đây là lớp thứ 2).
# Sinh: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Internal ──
# Sinh mới: python -c "import secrets;print(secrets.token_urlsafe(32))"
INTERNAL_AUTH_TOKEN=

# ── MinIO (instance staging rỗng, không copy ảnh chấm công từ prod) ──
MINIO_ROOT_USER=desi-staging-minio
MINIO_ROOT_PASSWORD=

# ── Tùy chọn ──
SENTRY_DSN=
WEB_WORKERS=2
CELERY_WORKER_CONCURRENCY=2

# Port bind localhost trên host (đổi nếu đụng port khác trên cùng máy)
STAGING_WEB_PORT=8100
STAGING_FRONTEND_PORT=8101
STAGING_POSTGRES_PORT=8543

# ── Xuất file chạy nền (apps.exports, spec 2026-08-06) ──
# worker-export ở staging hardcode concurrency=1, không có mem_limit riêng (khác
# prod) nên KHÔNG cần EXPORT_WORKER_CONCURRENCY/EXPORT_WORKER_MAX_MEMORY_PER_CHILD
# ở đây — chỉ 6 biến app-level dưới đây có tác dụng, mirror khối trong .env.example.
CELERY_EXPORTS_QUEUE=exports
MINIO_BUCKET_EXPORTS=desi-exports
EXPORT_FILE_TTL_HOURS=24
EXPORT_SOFT_TIME_LIMIT=600
EXPORT_MAX_ACTIVE_JOBS_PER_USER=5
EXPORT_CREATE_THROTTLE_RATE=30/hour

# ── Trang sản phẩm public /sp/<mã> (docs/product-scan-page-design.md) ──
MINIO_BUCKET_PRODUCTS=product-media

# ===== Đã chuyển vào DB (2026-09-19) =====
# Credential đối tác (Lark, Gemini, Zenify, CNV, token API vào…) và tham số vận hành
# (cờ bật/tắt, ngưỡng QA, thông tin công ty portal — kể cả KIOTVIET_WEBHOOK_SECRET,
# ORDERS_INGEST_API_TOKEN, WARRANTY_QR_BASE_URL, PORTAL_COMPANY_*) KHÔNG còn đọc từ
# .env — sửa ở Cài đặt → Cấu hình hệ thống (superuser) SAU khi stack staging đã lên.
# `sysconfig.get()` trả default (không phải giá trị prod) cho mọi khóa
# staging_forbidden bất kể DB, và `manage.py staging_neutralize --yes` xoá thêm các
# khóa đó + nhóm "Token API vào" (inbound_tokens) — đặt lại token/URL test riêng cho
# staging (KHÔNG dùng secret prod; KHÔNG register webhook KiotViet từ staging — sẽ
# ghi đè URL webhook prod, test bằng curl payload mẫu). Danh sách khóa:
# backend/apps/sysconfig/registry.py. Boot sẽ CHẾT nếu .env còn khóa nào trong danh
# sách đó. Xem docs/system-settings.md.
# SYSCONFIG_ALLOW_ENV_KEYS=1   # chỉ trong cửa sổ deploy chuyển đổi

# ⛔ TUYỆT ĐỐI KHÔNG khai báo ở staging (settings guard sẽ refuse boot nếu có):
#   KIOTVIET_API_MODE=live. Mọi LARK_*/ZENIFY_API_KEY/ZENIFY_API_SECRET/GEMINI_API_KEY/
#   CHAT_CRAWLER_DB_PASSWORD… giờ còn bị chặn HAI LỚP: guard staging (prefix LARK_)
#   VÀ guard registry env leftovers (mọi khóa sysconfig, mọi môi trường). Best Express
#   username/password không còn đọc từ env ở bất kỳ đâu (BestExpressAccount).
