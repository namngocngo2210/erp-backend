# Environment Variables Example
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Django Configuration
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Encryption Configuration
# IMPORTANT: Generate a new key using: python manage.py generate_encryption_key
# This key is used to encrypt sensitive data like client_secret and password
# Keep this key safe and never commit it to version control
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# KiotViet API Configuration
KIOTVIET_API_URL=https://public.kiotviet.vn

# Quét xuất kho: xác minh realtime với KiotViet rằng đơn chưa hủy (fail-closed).
# Đặt 0 khi KiotViet sự cố kéo dài để kho không đứng hình (tạm quay về check DB).
# Xem docs/scan-cancel-verify-runbook.md
SCAN_VERIFY_CANCEL_REALTIME=1
SCAN_VERIFY_TIMEOUT_SECONDS=3
SCAN_VERIFY_CACHE_TTL_OK=300
SCAN_VERIFY_CACHE_TTL_CANCELLED=300

# ===== Đã chuyển vào DB (2026-09-19) =====
# Credential đối tác (Lark, Gemini, Zenify, CNV, token API vào…) và tham số vận hành
# (cờ bật/tắt, ngưỡng QA, thông tin công ty portal…) KHÔNG còn đọc từ .env — sửa ở
# Cài đặt → Cấu hình hệ thống (superuser). Danh sách khóa: backend/apps/sysconfig/registry.py.
# Boot sẽ CHẾT nếu .env còn khóa nào trong danh sách đó. Xem docs/system-settings.md.
# Trong đó có mọi LARK_OPEN_*/LARK_BITABLE_*/LARK_CANCEL_DISPATCH_BOT_*/
# LARK_CHECKIN_REMINDER_*, WARRANTY_QR_BASE_URL, PORTAL_COMPANY_*.
# SYSCONFIG_ALLOW_ENV_KEYS=1   # chỉ trong cửa sổ deploy chuyển đổi

# Best Express (đấu nối trực tiếp Best V3): không còn khóa nào ở .env. Tài khoản
# (environment/username/password/EMS key) quản lý trên bảng BestExpressAccount
# (Django admin); webhook token nằm ở BestExpressAccount.webhook_token.

# ── Trang sản phẩm public /sp/<mã> (docs/product-scan-page-design.md) ──
# LƯU Ý: giống khối export bên dưới, file này KHÔNG được docker compose đọc.
# Biến thật compose dùng nằm ở `.env.example` gốc repo — sửa giá trị ở ĐÓ.
MINIO_BUCKET_PRODUCTS=product-media

# ── Xuất file chạy nền (apps.exports) ──
# LƯU Ý: file này KHÔNG được docker compose đọc (không service nào khai
# `env_file` trỏ vào đây). Biến thật compose dùng nằm ở `.env.example` gốc repo
# (mục "Xuất file chạy nền") — sửa giá trị ở ĐÓ, sửa ở đây chỉ để tham khảo.
CELERY_EXPORTS_QUEUE=exports
EXPORT_WORKER_CONCURRENCY=2
EXPORT_WORKER_MAX_MEMORY_PER_CHILD=250000
MINIO_BUCKET_EXPORTS=desi-exports
EXPORT_FILE_TTL_HOURS=24
EXPORT_SOFT_TIME_LIMIT=600
EXPORT_MAX_ACTIVE_JOBS_PER_USER=5
EXPORT_CREATE_THROTTLE_RATE=30/hour

# Other Configuration
# Add your other environment variables here

# Retention (ngày) cho order_journey_events; 0 = giữ vĩnh viễn. Prod: 180.
JOURNEY_EVENT_RETENTION_DAYS=0
